//以下信号来自BMS通过CAN广播
typedef struct tag_BMSInfoFromCanBroad
{	
	UINT8	u8ExistStat;
	UINT8	u8Valid;
	UINT8	u8CommFailAlm;
	UINT8	u8CommAlmDelay;

	UINT8	BMS_ProState;			//0x32   0:未就绪 1:就绪 2:充电截止 3:放电截止 4:充放电限制 5:充放电保护
	UINT8	BMS_WorkState;
	UINT8	BMS_ChgState;
	UINT8	BMS_WorkMode;
	float	BMS_Limit_ChargeCurrent;		//0x33
	float	BMS_Limit_DischargeCurrent;
	float	BMS_Limit_ChargePower;
	float	BMS_Limit_DischargePower;
	float	BMS_Limit_ChargeVoltage;	//0x34
	float  BMS_Limit_DischargeVoltage;
	float	BMS_SumVolt;		//0x3C
	float	BMS_OutCurrent;	
	float	BMS_OutPower;	
	float	BMS_OutVolt;	
}_BMSInfoFromCanBroad;


typedef struct _BackupBatteryMng
{
	UINT8 RemainCap;	//电池容量

	UINT8 IsGotCtrlCmd0x61;		//是否收到IMMU2的控制命令0x61
	UINT8 CtrlStatFromCmd0x61;	//IMMU2的控制命令0x61  0-stop charging 1-start charging 2-pengding

	//IMMU2下发控制
	UINT8	u8TaskCtrlCmd;
	float ChargeVoltReq;
	float ChargeCurrReq;
	float EVDischargeCurrReq;	//汽车放电给储能电池,请求放电电流

	float fOutVolt;
	float fOutCurr;
	float fMaxAlowPwr_Disch_ACDC;		//放电功率
	float fMaxAlowPwr_Disch_DCDC;		//放电功率

	float fMaxAlowPwr_Chg_ACDC;		//充电功率
	float fMaxAlowPwr_Chg_MPPT;		//充电功率

	//控制请求
	UINT8 CtrlReq;				//0-无请求  1-请求电池动作（充或放）
	UINT8 CtrlReqType;			//控制请求内容 0-无 1-充电 2-放电
	UINT8 CtrlReqWaitAckDelay;  //控制请求需要得到IMMU2确认回复，否则重复发
	//ACK
	UINT8 ContactorStatus;
	float MaxAllowChargeVoltage;
	float MaxAllowChargeCurrent;

	//直接从CAN获取的BMS信息
	_BMSInfoFromCanBroad BattInfoFromCan;

	//允许充放电的DI信号
	UINT8	u8IsAllowChgOrDischgFromDI;		//是否允许充放电的DI信号状态，默认禁止0， 允许是

}EnergySystemBatteryMngDef;

