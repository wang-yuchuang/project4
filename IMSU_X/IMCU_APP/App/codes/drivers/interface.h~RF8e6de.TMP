	UINT8 u8LogInType;					//登录方式，APP CARD admin!		87		   //#define EV_ENTER_IC_CARD 1		#define EV_ENTER_APP 2		#define EV_ENTER_admin 3
	UINT8 u8StopReason;					//88
	UINT8 u8Reserve;					//89
