	ES_BATT_TASK_TYPE_Batt2Grid,	//储能电池给电网放电
	ES_BATT_TASK_TYPE_Ev2Batt,		//汽车给储能电池放电
	ES_BATT_TASK_TYPE_Batt2Ev,		//储能电池给汽车充电
};

