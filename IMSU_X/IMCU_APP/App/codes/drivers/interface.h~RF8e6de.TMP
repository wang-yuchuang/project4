	//单模块命令/**/
	_CAN_0_R_CMD_ID_S_03 = 0,		//GetSingle_VoltCurr	电压、电流/**/ 
	_CAN_1_R_CMD_ID_S_04,			//GetSingle_GrpAndStatus	组号、状态/**/
	_CAN_2_R_CMD_ID_S_06,			//GetSingle_PhaseVolts	三相电压/**/
	_CAN_3_R_CMD_ID_S_07,			//GetSingle_VerInfo 版本号/**/
	_CAN_4_R_CMD_ID_S_1A,			//SetSingle_OnOff	单模块开关机, 注意单模块调压限流不再支持/**/
	_CAN_5_R_CMD_ID_S_14,			//SetSingle_LedFlash	单模块灯闪/**/
	_CAN_6_R_CMD_ID_S_1E,			//SetSingle_Reset	单模复位**/
	_CAN_7_R_CMD_ID_S_0C,			//GetSingle_Power	读单模块的当前电压下 最大电流 以求功率！

	//模块组命令/**/
	_CAN_8_R_CMD_ID_G_01,			//GetGrp_VoltCurr	总电压、电流/**/
	_CAN_9_R_CMD_ID_G_02,			//GetGrp_NumAndStatus	模块个数、系统状态/**/
	_CAN_10_R_CMD_ID_G_1A,			//SetGrp_OnOff_No10	模块组开关机/**/
	_CAN_11_R_CMD_ID_G_0F,			//SetBroad_IinLimit
	_CAN_12_R_CMD_ID_G_13,			//SetGrp_WalkIn	设置WalkIn/**/
	_CAN_13_R_CMD_ID_G_1B,			 //SetGrp_AdjVoltCurr_No13	模块组调压、限流/**/
	_CAN_14_R_CMD_ID_G_0A,			//GetGrp_MaxMinVoltCurr	目前讨论的结果是只需要最大电压电流，在新协议中，增加0x0A命令。注：电压回复值单位为V，电流回复值单位为0.1A
	//0x0A//读	 /最大电压Hi 最大电压Lo 最小电压Hi 最小电压Lo 最大电流Hi 最大电流Lo, Power Hi, Power Lo/**/

	_MAX_CAN_R_CMD

}ID_CMD_RECT;






