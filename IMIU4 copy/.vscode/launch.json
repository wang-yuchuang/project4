
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32G0B1 Debug (OpenOCD)",
            "cwd": "${workspaceRoot}",
            "executable": "./build/IMIU4.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "device": "STM32G0B1xx",
