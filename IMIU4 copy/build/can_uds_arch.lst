 239:./Application/Addition/UDSCanfd/can_uds_arch.c **** unsigned long uds_crc(unsigned long crc, const void *buffer, int size) 
 240:./Application/Addition/UDSCanfd/can_uds_arch.c **** {
 241:./Application/Addition/UDSCanfd/can_uds_arch.c ****     static const unsigned long rtable[16] = {
 242:./Application/Addition/UDSCanfd/can_uds_arch.c ****         0x00000000, 0x1db71064, 0x3b6e20c8, 0x26d930ac,
 243:./Application/Addition/UDSCanfd/can_uds_arch.c ****         0x76dc4190, 0x6b6b51f4, 0x4db26158, 0x5005713c,
 244:./Application/Addition/UDSCanfd/can_uds_arch.c ****         0xedb88320, 0xf00f9344, 0xd6d6a3e8, 0xcb61b38c,
 245:./Application/Addition/UDSCanfd/can_uds_arch.c ****         0x9b64c2b0, 0x86d3d2d4, 0xa00ae278, 0xbdbdf21c,
 246:./Application/Addition/UDSCanfd/can_uds_arch.c ****     };
 247:./Application/Addition/UDSCanfd/can_uds_arch.c **** 
 248:./Application/Addition/UDSCanfd/can_uds_arch.c ****     const uint8_t *data = buffer;
 249:./Application/Addition/UDSCanfd/can_uds_arch.c **** 
 250:./Application/Addition/UDSCanfd/can_uds_arch.c ****     for (int i = 0; i < size; i++) {
 251:./Application/Addition/UDSCanfd/can_uds_arch.c ****         crc = (crc >> 4) ^ rtable[(crc ^ (data[i] >> 0)) & 0xf];
 252:./Application/Addition/UDSCanfd/can_uds_arch.c ****         crc = (crc >> 4) ^ rtable[(crc ^ (data[i] >> 4)) & 0xf];
 253:./Application/Addition/UDSCanfd/can_uds_arch.c ****     }
 254:./Application/Addition/UDSCanfd/can_uds_arch.c **** 
 255:./Application/Addition/UDSCanfd/can_uds_arch.c ****     return crc;
 256:./Application/Addition/UDSCanfd/can_uds_arch.c **** }
