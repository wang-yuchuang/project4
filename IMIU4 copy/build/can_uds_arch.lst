 289:./Application/Addition/UDSCanfd/can_uds_arch.c **** // --- 内部函数 ---
 290:./Application/Addition/UDSCanfd/can_uds_arch.c **** static unsigned long transform1(unsigned long seed) 
 291:./Application/Addition/UDSCanfd/can_uds_arch.c **** {
 292:./Application/Addition/UDSCanfd/can_uds_arch.c ****     unsigned char* b = (unsigned char*)&seed;
 293:./Application/Addition/UDSCanfd/can_uds_arch.c ****     for(int i=0; i<4; i++) {
 294:./Application/Addition/UDSCanfd/can_uds_arch.c ****         b[i] = (b[i] << 1) | (b[i] >> 7);
 295:./Application/Addition/UDSCanfd/can_uds_arch.c ****         b[i] ^= 0x1B; // 类似AES的轮常数[[9]]
 296:./Application/Addition/UDSCanfd/can_uds_arch.c ****     }
 297:./Application/Addition/UDSCanfd/can_uds_arch.c ****     return seed;
 298:./Application/Addition/UDSCanfd/can_uds_arch.c **** }
 299:./Application/Addition/UDSCanfd/can_uds_arch.c **** 
 300:./Application/Addition/UDSCanfd/can_uds_arch.c **** static unsigned long transform2(unsigned long seed) 
 301:./Application/Addition/UDSCanfd/can_uds_arch.c **** {
 302:./Application/Addition/UDSCanfd/can_uds_arch.c ****     unsigned long temp = (seed >> 24) |          // 取第一个字节
 303:./Application/Addition/UDSCanfd/can_uds_arch.c ****                    ((seed >> 8) & 0xFF00) | // 取第二个字节
 304:./Application/Addition/UDSCanfd/can_uds_arch.c ****                    ((seed << 8) & 0xFF0000)|// 取第三个字节
 305:./Application/Addition/UDSCanfd/can_uds_arch.c ****                    (seed << 24);            // 取第四个字节
 306:./Application/Addition/UDSCanfd/can_uds_arch.c ****     return temp ^ 0xA5A555AA;
 307:./Application/Addition/UDSCanfd/can_uds_arch.c **** }
