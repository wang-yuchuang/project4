 210:./Application/Logics/Insulation/Insulation.c **** 							/*只在状态仍为Process时才设OverTime，避免覆盖STEP_3已设置的Fault*/
 211:./Application/Logics/Insulation/Insulation.c **** 							if(gs_InsulationDetectMng.ucInsulationState == eInsulation_Process)
 212:./Application/Logics/Insulation/Insulation.c **** 							{
