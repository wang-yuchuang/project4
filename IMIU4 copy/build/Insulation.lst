 184:./Application/Logics/Insulation/Insulation.c **** 				{
 185:./Application/Logics/Insulation/Insulation.c **** 					if(s_u8StartTimerInit == 0)
 186:./Application/Logics/Insulation/Insulation.c **** 					{
