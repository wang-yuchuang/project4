 282:./Application/Logics/Insulation/Insulation.c **** /*=============================================================================================
 283:./Application/Logics/Insulation/Insulation.c **** ** @Name      : u8 CheckInsulationTaskWithDynamicPeriod(void);
 284:./Application/Logics/Insulation/Insulation.c **** ** @Input     : void
 285:./Application/Logics/Insulation/Insulation.c **** ** @Output    : void
 286:./Application/Logics/Insulation/Insulation.c **** ** @Function  : 绝缘检测采样周期控制 (秒s)
 287:./Application/Logics/Insulation/Insulation.c **** ** @The notes : 
 288:./Application/Logics/Insulation/Insulation.c **** **===========================================================================================*/
 289:./Application/Logics/Insulation/Insulation.c **** static u8 CheckInsulationTaskWithDynamicPeriod(void)
 290:./Application/Logics/Insulation/Insulation.c **** {
 291:./Application/Logics/Insulation/Insulation.c **** 	static TickType_t xLastWakeTime = 0;
 292:./Application/Logics/Insulation/Insulation.c **** 	static uint32_t Period = 0;
 293:./Application/Logics/Insulation/Insulation.c **** 	static u8 s_u8PeriodInit = 0;
 294:./Application/Logics/Insulation/Insulation.c ****         TickType_t xCurrentTime;
 295:./Application/Logics/Insulation/Insulation.c ****         uint32_t u32CurrentPeriod;
 296:./Application/Logics/Insulation/Insulation.c ****     
 297:./Application/Logics/Insulation/Insulation.c ****     // 获取当前采样周期
 298:./Application/Logics/Insulation/Insulation.c ****     // 秒直接转 ticks，避免 pdMS_TO_TICKS 内部乘法溢出 (21600s*1000ms*1000Hz > uint32_
 299:./Application/Logics/Insulation/Insulation.c ****     u32CurrentPeriod = (uint32_t)stParameter.u16ArraySet[InsuSampPeriod] * (uint32_t)configTICK_RAT
 300:./Application/Logics/Insulation/Insulation.c ****     
 301:./Application/Logics/Insulation/Insulation.c ****     // 首次调用
 302:./Application/Logics/Insulation/Insulation.c ****     if (s_u8PeriodInit == 0)
 303:./Application/Logics/Insulation/Insulation.c ****     {
 304:./Application/Logics/Insulation/Insulation.c ****         xLastWakeTime = xTaskGetTickCount();
 305:./Application/Logics/Insulation/Insulation.c ****         Period = u32CurrentPeriod;
 306:./Application/Logics/Insulation/Insulation.c ****         s_u8PeriodInit = 1;
 307:./Application/Logics/Insulation/Insulation.c ****         return 0;  //首次调用:开始计时,不立即触发
 308:./Application/Logics/Insulation/Insulation.c ****     }
 309:./Application/Logics/Insulation/Insulation.c ****     
 310:./Application/Logics/Insulation/Insulation.c ****     // 外部请求重置周期基准
 311:./Application/Logics/Insulation/Insulation.c ****     if (s_u8PeriodResetReq == 1)
 312:./Application/Logics/Insulation/Insulation.c ****     {
 313:./Application/Logics/Insulation/Insulation.c ****         s_u8PeriodResetReq = 0;
 314:./Application/Logics/Insulation/Insulation.c ****         xLastWakeTime = xTaskGetTickCount();
 315:./Application/Logics/Insulation/Insulation.c ****         return 0;  //重置后不立即触发
 316:./Application/Logics/Insulation/Insulation.c ****     }
 317:./Application/Logics/Insulation/Insulation.c ****     
ARM GAS  /tmp/ccyblaXp.s 			page 7


 318:./Application/Logics/Insulation/Insulation.c ****     xCurrentTime = xTaskGetTickCount();
 319:./Application/Logics/Insulation/Insulation.c ****     
 320:./Application/Logics/Insulation/Insulation.c ****     // 检查周期是否发生变化
 321:./Application/Logics/Insulation/Insulation.c ****     if (u32CurrentPeriod != Period)
 322:./Application/Logics/Insulation/Insulation.c ****     {
 323:./Application/Logics/Insulation/Insulation.c ****         // 周期变化，重新初始化时间基准
 324:./Application/Logics/Insulation/Insulation.c ****         Period = u32CurrentPeriod;
 325:./Application/Logics/Insulation/Insulation.c ****         xLastWakeTime = xCurrentTime;
 326:./Application/Logics/Insulation/Insulation.c ****         return 1;  // 周期变化时立即执行一次
 327:./Application/Logics/Insulation/Insulation.c ****     }
 328:./Application/Logics/Insulation/Insulation.c ****     
 329:./Application/Logics/Insulation/Insulation.c ****     // 检查是否达到采样周期
 330:./Application/Logics/Insulation/Insulation.c ****     if ((xCurrentTime - xLastWakeTime) >= u32CurrentPeriod)
 331:./Application/Logics/Insulation/Insulation.c ****     {
 332:./Application/Logics/Insulation/Insulation.c ****         // 更新时间基准
 333:./Application/Logics/Insulation/Insulation.c ****         xLastWakeTime += u32CurrentPeriod;//500
 334:./Application/Logics/Insulation/Insulation.c ****         
 335:./Application/Logics/Insulation/Insulation.c ****         // 防止因长时间阻塞导致的时间漂移
 336:./Application/Logics/Insulation/Insulation.c ****         if ((xCurrentTime - xLastWakeTime) > u32CurrentPeriod)
 337:./Application/Logics/Insulation/Insulation.c ****         {
 338:./Application/Logics/Insulation/Insulation.c ****             xLastWakeTime = xCurrentTime;
 339:./Application/Logics/Insulation/Insulation.c ****         }
 340:./Application/Logics/Insulation/Insulation.c **** #ifdef INSULATION_TEST
 341:./Application/Logics/Insulation/Insulation.c **** 
 342:./Application/Logics/Insulation/Insulation.c **** 		static TickType_t s_LastTriggerTime = 0;
 343:./Application/Logics/Insulation/Insulation.c **** 		TickType_t now  = xTaskGetTickCount();
 344:./Application/Logics/Insulation/Insulation.c **** 		if (s_LastTriggerTime != 0)
 345:./Application/Logics/Insulation/Insulation.c **** 		{
 346:./Application/Logics/Insulation/Insulation.c **** 			SEGGER_RTT_printf(0, "[Test Insulation cycle] dt= %dms\r\n", 
 347:./Application/Logics/Insulation/Insulation.c ****             (int)((now -s_LastTriggerTime)* portTICK_PERIOD_MS));
 348:./Application/Logics/Insulation/Insulation.c **** 		}
 349:./Application/Logics/Insulation/Insulation.c **** 		s_LastTriggerTime = now;
 350:./Application/Logics/Insulation/Insulation.c **** #endif
 351:./Application/Logics/Insulation/Insulation.c ****         return 1;  // 达到时间
 352:./Application/Logics/Insulation/Insulation.c **** 		
 353:./Application/Logics/Insulation/Insulation.c ****     }
 354:./Application/Logics/Insulation/Insulation.c ****     
 355:./Application/Logics/Insulation/Insulation.c ****     return 0;  // 未达到时间
 356:./Application/Logics/Insulation/Insulation.c **** }
