 246:./Application/Logics/Insulation/Insulation.c **** 				}
 247:./Application/Logics/Insulation/Insulation.c **** 				else /*End/OverTime/Fault: 终态锁存，确保CAN 1s周期上传*/
 248:./Application/Logics/Insulation/Insulation.c **** 				{
 249:./Application/Logics/Insulation/Insulation.c **** 					/*首次进入终态: 恢复开关 + 记录时刻*/
