 189:./Application/Logics/Insulation/Insulation.c **** 					}
 190:./Application/Logics/Insulation/Insulation.c **** 					else if (((GetRunTimers() + RunTimersOverflow - u32StartTimer)%RunTimersOverflow) > stParamete
 191:./Application/Logics/Insulation/Insulation.c **** 					//电压如果一直小于启动电压，则停止运行
 192:./Application/Logics/Insulation/Insulation.c **** 					{
