 237:./Application/Logics/Insulation/Insulation.c **** 				if(gs_InsulationDetectMng.ucInsulationState == eInsulation_Stop)
 238:./Application/Logics/Insulation/Insulation.c **** 				{
 239:./Application/Logics/Insulation/Insulation.c **** 					Insulation_RestoreSwitchAndTimer();
 240:./Application/Logics/Insulation/Insulation.c **** 					u32StartTimer = 0;
 241:./Application/Logics/Insulation/Insulation.c **** 					s_u8StartTimerInit = 0;
