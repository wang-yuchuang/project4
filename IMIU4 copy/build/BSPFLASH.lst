  71:./Application/BSPSys/BSPDriver/BSPFLASH.c **** /*=============================================================================================
  72:./Application/BSPSys/BSPDriver/BSPFLASH.c **** ** @Name      : static u32 get_pagenum(u32 Addr)
  73:./Application/BSPSys/BSPDriver/BSPFLASH.c **** ** @Input     : stru_flash_pos *flash_pos：pull in addr,pull out bank number & page number
  74:./Application/BSPSys/BSPDriver/BSPFLASH.c **** ** @Output    : TRUE 成功, FALSE 失败
  75:./Application/BSPSys/BSPDriver/BSPFLASH.c **** ** @Function  : 根据flash地址获取块、页序号
  76:./Application/BSPSys/BSPDriver/BSPFLASH.c **** ** @The notes : 按规格书划分匹配页号
  77:./Application/BSPSys/BSPDriver/BSPFLASH.c **** **===========================================================================================*/
  78:./Application/BSPSys/BSPDriver/BSPFLASH.c **** static u32 get_flash_pos(stru_flash_pos *flash_pos)
  79:./Application/BSPSys/BSPDriver/BSPFLASH.c **** {
  80:./Application/BSPSys/BSPDriver/BSPFLASH.c ****     u32 pagenum = 0,temp_addr = 0;
  81:./Application/BSPSys/BSPDriver/BSPFLASH.c ****     if(flash_pos->addr < FLASH_ADDR_START || flash_pos->addr >= (FLASH_ADDR_START+FLASH_ADDR_SIZE))
  82:./Application/BSPSys/BSPDriver/BSPFLASH.c ****         return FALSE;
  83:./Application/BSPSys/BSPDriver/BSPFLASH.c ****     temp_addr = flash_pos->addr - FLASH_ADDR_START;
  84:./Application/BSPSys/BSPDriver/BSPFLASH.c ****     pagenum = temp_addr/FLASH_PAGE_SIZE;
  85:./Application/BSPSys/BSPDriver/BSPFLASH.c ****     /*stm32g0b1xx flash page number 跨bank不连续*/
  86:./Application/BSPSys/BSPDriver/BSPFLASH.c ****     if(pagenum > 127){
  87:./Application/BSPSys/BSPDriver/BSPFLASH.c ****         flash_pos->bank_index = 1;
  88:./Application/BSPSys/BSPDriver/BSPFLASH.c ****         flash_pos->page_index = pagenum - FLASH_PAGE_NB + 256;
  89:./Application/BSPSys/BSPDriver/BSPFLASH.c ****     }
  90:./Application/BSPSys/BSPDriver/BSPFLASH.c ****     else{
  91:./Application/BSPSys/BSPDriver/BSPFLASH.c **** 
  92:./Application/BSPSys/BSPDriver/BSPFLASH.c ****         flash_pos->bank_index = 0;
  93:./Application/BSPSys/BSPDriver/BSPFLASH.c ****         flash_pos->page_index = pagenum;
  94:./Application/BSPSys/BSPDriver/BSPFLASH.c ****     }
  95:./Application/BSPSys/BSPDriver/BSPFLASH.c **** 
  96:./Application/BSPSys/BSPDriver/BSPFLASH.c ****     return TRUE;
  97:./Application/BSPSys/BSPDriver/BSPFLASH.c **** }
