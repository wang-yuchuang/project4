ARM GAS  /tmp/ccHJ61Gv.s 			page 11


 285:./Application/BSPSys/BSPDriver/BSPUSART.c **** 				(void)BSPUSARTSendMsg((e_USARTNUM)index, &txMsg);               //直接重发一次
