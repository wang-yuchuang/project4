 451:./Application/BSPSys/BSPDriver/BSPUSART.c ****     //计算缓冲区未处理信息
 452:./Application/BSPSys/BSPDriver/BSPUSART.c ****     if(sUSARTCyUnDealNum[usartNum] < 0xff)
 453:./Application/BSPSys/BSPDriver/BSPUSART.c ****     {
