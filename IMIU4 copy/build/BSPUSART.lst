 440:./Application/BSPSys/BSPDriver/BSPUSART.c **** ** @The notes :
 441:./Application/BSPSys/BSPDriver/BSPUSART.c **** **===========================================================================================*/
 442:./Application/BSPSys/BSPDriver/BSPUSART.c **** static u8 USARTWriteRcvCyBuf(e_USARTNUM usartNum, u8 * wdata, u8 size)
 443:./Application/BSPSys/BSPDriver/BSPUSART.c **** {
