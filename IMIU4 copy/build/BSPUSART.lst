 460:./Application/BSPSys/BSPDriver/BSPUSART.c ****     {
 461:./Application/BSPSys/BSPDriver/BSPUSART.c **** 
 462:./Application/BSPSys/BSPDriver/BSPUSART.c ****         //写长度
 463:./Application/BSPSys/BSPDriver/BSPUSART.c ****         sUSARTRcvCyBuf[usartNum].uRcvBuf[wrtPoint].len = size;		
 464:./Application/BSPSys/BSPDriver/BSPUSART.c **** 
 465:./Application/BSPSys/BSPDriver/BSPUSART.c ****         //写数据
 466:./Application/BSPSys/BSPDriver/BSPUSART.c ****         for (i = 0; i < sUSARTRcvCyBuf[usartNum].uRcvBuf[wrtPoint].len; i++)
 467:./Application/BSPSys/BSPDriver/BSPUSART.c ****         {
