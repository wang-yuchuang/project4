 761:./Application/Funtion/CanLib/CANTabOper.c **** ** @Name      : u8 CANComputeRequestCRC8(u16 ApplicationId, const u8* Crc_DataPtr, u16 Crc_Length)
 762:./Application/Funtion/CanLib/CANTabOper.c **** ** @Input     : ApplicationId:帧ID低16位 Crc_DataPtr:需要计算校验码的数组 Crc_Length:�
 763:./Application/Funtion/CanLib/CANTabOper.c **** ** @Output    : void
 764:./Application/Funtion/CanLib/CANTabOper.c **** ** @Function  : 按SAE J1850 方式计算CRC值
 765:./Application/Funtion/CanLib/CANTabOper.c **** ** @The notes : 请求修改命令帧长度不满8byte但发完8byte时使用
 766:./Application/Funtion/CanLib/CANTabOper.c **** **===============================================================================================*/
 767:./Application/Funtion/CanLib/CANTabOper.c **** u8 CANComputeRequestCRC8(u16 ApplicationId, const u8* Crc_DataPtr, u16 Crc_Length)
 768:./Application/Funtion/CanLib/CANTabOper.c **** {
 769:./Application/Funtion/CanLib/CANTabOper.c **** 	u16 count = 0; 		/* loop counter for CRC calculation */
 770:./Application/Funtion/CanLib/CANTabOper.c **** 	u8 crc_value = 0; 	/* CRC initial value */
 771:./Application/Funtion/CanLib/CANTabOper.c **** 	u8 XOR_out = 0; 	/* Value to XOR output */
 772:./Application/Funtion/CanLib/CANTabOper.c **** 
 773:./Application/Funtion/CanLib/CANTabOper.c **** 	crc_value = 0xffu;
 774:./Application/Funtion/CanLib/CANTabOper.c **** 	XOR_out = 0xffu;
 775:./Application/Funtion/CanLib/CANTabOper.c **** 	crc_value = Crc8Table[crc_value ^ (u8)(ApplicationId & 0x00ffu)]; 	/* Calculate CRC of low byte of
 776:./Application/Funtion/CanLib/CANTabOper.c **** 	crc_value = Crc8Table[crc_value ^ (u8)(ApplicationId >> 8)]; 		/* Calculate CRC of high byte of Ap
 777:./Application/Funtion/CanLib/CANTabOper.c **** 
 778:./Application/Funtion/CanLib/CANTabOper.c **** 	for (count = 0; count < (u16)Crc_Length; count++) 					/* Calculate CRC of data block */
 779:./Application/Funtion/CanLib/CANTabOper.c **** 	{
 780:./Application/Funtion/CanLib/CANTabOper.c **** 		crc_value = Crc8Table[crc_value ^ Crc_DataPtr[count]];
 781:./Application/Funtion/CanLib/CANTabOper.c **** 	}
 782:./Application/Funtion/CanLib/CANTabOper.c **** 	crc_value = crc_value ^ XOR_out;
 783:./Application/Funtion/CanLib/CANTabOper.c **** 
 784:./Application/Funtion/CanLib/CANTabOper.c **** 	/* Calculate the official checksum.*/
 785:./Application/Funtion/CanLib/CANTabOper.c **** 	return(crc_value);
 786:./Application/Funtion/CanLib/CANTabOper.c **** }
