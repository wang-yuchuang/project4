 437:./Application/Funtion/Usart/Calibration.c **** void CalibrationReadCoeffFromModbus(Calibration_Type type, f32* k, float32 *b)
 438:./Application/Funtion/Usart/Calibration.c **** {
 439:./Application/Funtion/Usart/Calibration.c ****     const CalibrationConfig* config = CalibrationGetConfig(type);
 440:./Application/Funtion/Usart/Calibration.c ****     if (config == NULL || k == NULL || b == NULL)
