1048:./Application/Funtion/Usart/Calibration.c **** /*=================================================================================================
1049:./Application/Funtion/Usart/Calibration.c **** ** @Name      : static void CalculateTwoPointCalibration(Calibration_Type type)
1050:./Application/Funtion/Usart/Calibration.c **** ** @Input     : void
1051:./Application/Funtion/Usart/Calibration.c **** ** @Output    : void
1052:./Application/Funtion/Usart/Calibration.c **** ** @Function  : 
1053:./Application/Funtion/Usart/Calibration.c **** ** @The notes : 执行双点校准计算
1054:./Application/Funtion/Usart/Calibration.c **** **===============================================================================================*/
1055:./Application/Funtion/Usart/Calibration.c **** static void CalculateTwoPointCalibration(Calibration_Type type)
1056:./Application/Funtion/Usart/Calibration.c **** {
1057:./Application/Funtion/Usart/Calibration.c ****     CalibrationParams* params = &g_params[type];
1058:./Application/Funtion/Usart/Calibration.c **** 
1059:./Application/Funtion/Usart/Calibration.c ****     if (params->input2 == params->input1)
1060:./Application/Funtion/Usart/Calibration.c ****     {
1061:./Application/Funtion/Usart/Calibration.c ****         CalculateSinglePointCalibration(type);
1062:./Application/Funtion/Usart/Calibration.c ****         return;
1063:./Application/Funtion/Usart/Calibration.c ****     }
1064:./Application/Funtion/Usart/Calibration.c ****     // 双点校准公式: y = k*x + b
1065:./Application/Funtion/Usart/Calibration.c ****     // 使用两点(x1,y1)和(x2,y2)计算k和b
1066:./Application/Funtion/Usart/Calibration.c ****     if (params->input2 != params->input1)
ARM GAS  /tmp/ccwSOYU2.s 			page 34


1067:./Application/Funtion/Usart/Calibration.c ****     {
1068:./Application/Funtion/Usart/Calibration.c ****         // 计算斜率 k = (y2 - y1) / (x2 - x1)
1069:./Application/Funtion/Usart/Calibration.c ****         params->k = (params->input2 - params->input1) / ( params->actual2 - params->actual1);
1070:./Application/Funtion/Usart/Calibration.c ****         // 计算偏移 b = y1 - k*x1
1071:./Application/Funtion/Usart/Calibration.c ****         params->b = params->input1 - params->k * params->actual1;
1072:./Application/Funtion/Usart/Calibration.c ****     }
1073:./Application/Funtion/Usart/Calibration.c ****     else
1074:./Application/Funtion/Usart/Calibration.c ****     {
1075:./Application/Funtion/Usart/Calibration.c ****         CalculateSinglePointCalibration(type);
1076:./Application/Funtion/Usart/Calibration.c ****     }
1077:./Application/Funtion/Usart/Calibration.c ****     params->valid_flag2 = 1;
1078:./Application/Funtion/Usart/Calibration.c **** }
1079:./Application/Funtion/Usart/Calibration.c **** 
