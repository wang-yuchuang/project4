 457:./Application/Funtion/Usart/Calibration.c **** /*=================================================================================================
 458:./Application/Funtion/Usart/Calibration.c **** ** @Name      : static void FloatToRegisters(float32 value, u16* high_word, u16* low_word)
 459:./Application/Funtion/Usart/Calibration.c **** ** @Input     : void
 460:./Application/Funtion/Usart/Calibration.c **** ** @Output    : 
 461:./Application/Funtion/Usart/Calibration.c **** ** @Function  : 
 462:./Application/Funtion/Usart/Calibration.c **** ** @The notes : 浮点数转换为寄存器数据
 463:./Application/Funtion/Usart/Calibration.c **** **===============================================================================================*/
 464:./Application/Funtion/Usart/Calibration.c **** static void FloatToRegisters(float32 value, u16* high_word, u16* low_word)
 465:./Application/Funtion/Usart/Calibration.c **** {
 466:./Application/Funtion/Usart/Calibration.c ****     FloatConverter converter;
 467:./Application/Funtion/Usart/Calibration.c ****     converter.float_val = value;
 468:./Application/Funtion/Usart/Calibration.c ****     // 小端序转换
 469:./Application/Funtion/Usart/Calibration.c ****     *low_word = (converter.bytes.byte1 << 8) | converter.bytes.byte0;
 470:./Application/Funtion/Usart/Calibration.c ****     *high_word = (converter.bytes.byte3 << 8) | converter.bytes.byte2;
 471:./Application/Funtion/Usart/Calibration.c **** }
 472:./Application/Funtion/Usart/Calibration.c **** /*=================================================================================================
 473:./Application/Funtion/Usart/Calibration.c **** ** @Name      : static float32 RegistersToFloat(u16 high_word, u16 low_word)
 474:./Application/Funtion/Usart/Calibration.c **** ** @Input     :
 475:./Application/Funtion/Usart/Calibration.c **** ** @Output    : 
 476:./Application/Funtion/Usart/Calibration.c **** ** @Function  : 
 477:./Application/Funtion/Usart/Calibration.c **** ** @The notes : 寄存器数据转换为浮点数
 478:./Application/Funtion/Usart/Calibration.c **** **===============================================================================================*/
 479:./Application/Funtion/Usart/Calibration.c **** static f32 RegistersToFloat(u16 high_word, u16 low_word)
 480:./Application/Funtion/Usart/Calibration.c **** {
 481:./Application/Funtion/Usart/Calibration.c ****     FloatConverter converter;
 482:./Application/Funtion/Usart/Calibration.c ****     // 小端序转换
 483:./Application/Funtion/Usart/Calibration.c ****     converter.bytes.byte0 = low_word & 0xFF;
 484:./Application/Funtion/Usart/Calibration.c ****     converter.bytes.byte1 = (low_word >> 8) & 0xFF;
 485:./Application/Funtion/Usart/Calibration.c ****     converter.bytes.byte2 = high_word & 0xFF;
 486:./Application/Funtion/Usart/Calibration.c ****     converter.bytes.byte3 = (high_word >> 8) & 0xFF;
 487:./Application/Funtion/Usart/Calibration.c ****     return converter.float_val;
ARM GAS  /tmp/ccwSOYU2.s 			page 10


 488:./Application/Funtion/Usart/Calibration.c **** }
