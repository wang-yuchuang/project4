1027:./Application/Funtion/Usart/Calibration.c **** ** @Name      : static void HALLZeroCalibration(Calibration_Type type)
1028:./Application/Funtion/Usart/Calibration.c **** ** @Input     : void
1029:./Application/Funtion/Usart/Calibration.c **** ** @Output    : void
1030:./Application/Funtion/Usart/Calibration.c **** ** @Function  : 
1031:./Application/Funtion/Usart/Calibration.c **** ** @The notes : Hall校零
1032:./Application/Funtion/Usart/Calibration.c **** **===============================================================================================*/
1033:./Application/Funtion/Usart/Calibration.c **** static void HALLZeroCalibration(Calibration_Type type)
1034:./Application/Funtion/Usart/Calibration.c **** {
1035:./Application/Funtion/Usart/Calibration.c ****     CalibrationParams* params = &g_params[type];
1036:./Application/Funtion/Usart/Calibration.c ****     // HALL校零只计算偏移量
1037:./Application/Funtion/Usart/Calibration.c ****     if (params->inputZeroFlag != 0)
1038:./Application/Funtion/Usart/Calibration.c ****     {
1039:./Application/Funtion/Usart/Calibration.c ****         params->zero_offset = params->inputZero - params->actualZero;
1040:./Application/Funtion/Usart/Calibration.c ****     }
1041:./Application/Funtion/Usart/Calibration.c ****     else
1042:./Application/Funtion/Usart/Calibration.c ****     {
1043:./Application/Funtion/Usart/Calibration.c ****         params->zero_offset= 0.0f;
1044:./Application/Funtion/Usart/Calibration.c ****     }
1045:./Application/Funtion/Usart/Calibration.c ****     params->valid_flag_Zero = 1;
1046:./Application/Funtion/Usart/Calibration.c **** }
