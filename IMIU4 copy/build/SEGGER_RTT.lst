 361:./Application/Addition/RTT/SEGGER_RTT.c **** *
 362:./Application/Addition/RTT/SEGGER_RTT.c **** *       _WriteBlocking()
 363:./Application/Addition/RTT/SEGGER_RTT.c **** *
 364:./Application/Addition/RTT/SEGGER_RTT.c **** *  Function description
 365:./Application/Addition/RTT/SEGGER_RTT.c **** *    Stores a specified number of characters in SEGGER RTT ring buffer
 366:./Application/Addition/RTT/SEGGER_RTT.c **** *    and updates the associated write pointer which is periodically
 367:./Application/Addition/RTT/SEGGER_RTT.c **** *    read by the host.
 368:./Application/Addition/RTT/SEGGER_RTT.c **** *    The caller is responsible for managing the write chunk sizes as
 369:./Application/Addition/RTT/SEGGER_RTT.c **** *    _WriteBlocking() will block until all data has been posted successfully.
 370:./Application/Addition/RTT/SEGGER_RTT.c **** *
 371:./Application/Addition/RTT/SEGGER_RTT.c **** *  Parameters
 372:./Application/Addition/RTT/SEGGER_RTT.c **** *    pRing        Ring buffer to post to.
 373:./Application/Addition/RTT/SEGGER_RTT.c **** *    pBuffer      Pointer to character array. Does not need to point to a \0 terminated string.
 374:./Application/Addition/RTT/SEGGER_RTT.c **** *    NumBytes     Number of bytes to be stored in the SEGGER RTT control block.
 375:./Application/Addition/RTT/SEGGER_RTT.c **** *
 376:./Application/Addition/RTT/SEGGER_RTT.c **** *  Return value
ARM GAS  /tmp/ccRade8p.s 			page 8


 377:./Application/Addition/RTT/SEGGER_RTT.c **** *    >= 0 - Number of bytes written into buffer.
 378:./Application/Addition/RTT/SEGGER_RTT.c **** */
 379:./Application/Addition/RTT/SEGGER_RTT.c **** static unsigned _WriteBlocking(SEGGER_RTT_BUFFER_UP* pRing, const char* pBuffer, unsigned NumBytes)
 380:./Application/Addition/RTT/SEGGER_RTT.c ****   unsigned NumBytesToWrite;
 381:./Application/Addition/RTT/SEGGER_RTT.c ****   unsigned NumBytesWritten;
 382:./Application/Addition/RTT/SEGGER_RTT.c ****   unsigned RdOff;
 383:./Application/Addition/RTT/SEGGER_RTT.c ****   unsigned WrOff;
 384:./Application/Addition/RTT/SEGGER_RTT.c ****   volatile char* pDst;
 385:./Application/Addition/RTT/SEGGER_RTT.c ****   //
 386:./Application/Addition/RTT/SEGGER_RTT.c ****   // Write data to buffer and handle wrap-around if necessary
 387:./Application/Addition/RTT/SEGGER_RTT.c ****   //
 388:./Application/Addition/RTT/SEGGER_RTT.c ****   NumBytesWritten = 0u;
 389:./Application/Addition/RTT/SEGGER_RTT.c ****   WrOff = pRing->WrOff;
 390:./Application/Addition/RTT/SEGGER_RTT.c ****   do {
 391:./Application/Addition/RTT/SEGGER_RTT.c ****     RdOff = pRing->RdOff;                         // May be changed by host (debug probe) in the me
 392:./Application/Addition/RTT/SEGGER_RTT.c ****     if (RdOff > WrOff) {
 393:./Application/Addition/RTT/SEGGER_RTT.c ****       NumBytesToWrite = RdOff - WrOff - 1u;
 394:./Application/Addition/RTT/SEGGER_RTT.c ****     } else {
 395:./Application/Addition/RTT/SEGGER_RTT.c ****       NumBytesToWrite = pRing->SizeOfBuffer - (WrOff - RdOff + 1u);
 396:./Application/Addition/RTT/SEGGER_RTT.c ****     }
 397:./Application/Addition/RTT/SEGGER_RTT.c ****     NumBytesToWrite = MIN(NumBytesToWrite, (pRing->SizeOfBuffer - WrOff));      // Number of bytes 
 398:./Application/Addition/RTT/SEGGER_RTT.c ****     NumBytesToWrite = MIN(NumBytesToWrite, NumBytes);
 399:./Application/Addition/RTT/SEGGER_RTT.c ****     pDst = (pRing->pBuffer + WrOff) + SEGGER_RTT_UNCACHED_OFF;
 400:./Application/Addition/RTT/SEGGER_RTT.c **** #if SEGGER_RTT_MEMCPY_USE_BYTELOOP
 401:./Application/Addition/RTT/SEGGER_RTT.c ****     NumBytesWritten += NumBytesToWrite;
 402:./Application/Addition/RTT/SEGGER_RTT.c ****     NumBytes        -= NumBytesToWrite;
 403:./Application/Addition/RTT/SEGGER_RTT.c ****     WrOff           += NumBytesToWrite;
 404:./Application/Addition/RTT/SEGGER_RTT.c ****     while (NumBytesToWrite--) {
 405:./Application/Addition/RTT/SEGGER_RTT.c ****       *pDst++ = *pBuffer++;
 406:./Application/Addition/RTT/SEGGER_RTT.c ****     };
 407:./Application/Addition/RTT/SEGGER_RTT.c **** #else
 408:./Application/Addition/RTT/SEGGER_RTT.c ****     SEGGER_RTT_MEMCPY((void*)pDst, pBuffer, NumBytesToWrite);
 409:./Application/Addition/RTT/SEGGER_RTT.c ****     NumBytesWritten += NumBytesToWrite;
 410:./Application/Addition/RTT/SEGGER_RTT.c ****     pBuffer         += NumBytesToWrite;
 411:./Application/Addition/RTT/SEGGER_RTT.c ****     NumBytes        -= NumBytesToWrite;
 412:./Application/Addition/RTT/SEGGER_RTT.c ****     WrOff           += NumBytesToWrite;
 413:./Application/Addition/RTT/SEGGER_RTT.c **** #endif
 414:./Application/Addition/RTT/SEGGER_RTT.c ****     if (WrOff == pRing->SizeOfBuffer) {
 415:./Application/Addition/RTT/SEGGER_RTT.c ****       WrOff = 0u;
 416:./Application/Addition/RTT/SEGGER_RTT.c ****     }
 417:./Application/Addition/RTT/SEGGER_RTT.c ****     RTT__DMB();                     // Force data write to be complete before writing the <WrOff>, 
 418:./Application/Addition/RTT/SEGGER_RTT.c ****     pRing->WrOff = WrOff;
 419:./Application/Addition/RTT/SEGGER_RTT.c ****   } while (NumBytes);
 420:./Application/Addition/RTT/SEGGER_RTT.c ****   return NumBytesWritten;
 421:./Application/Addition/RTT/SEGGER_RTT.c **** }
