ARM GAS  /tmp/cccdeKhJ.s 			page 4


 141:./Application/BSPSys/BSPDriver/BSPCAN.c **** u8 BSPCANSendMsg(e_CANNUM canNum, t_CANMSG *msg)
 142:./Application/BSPSys/BSPDriver/BSPCAN.c **** {	
 143:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	static u8 failureCountCAN1 = 0; // CAN0 发送失败计数器  
 144:./Application/BSPSys/BSPDriver/BSPCAN.c **** 
 145:./Application/BSPSys/BSPDriver/BSPCAN.c ****     if(0 == msg->Len)
 146:./Application/BSPSys/BSPDriver/BSPCAN.c ****     {
 147:./Application/BSPSys/BSPDriver/BSPCAN.c ****         return(FALSE);
 148:./Application/BSPSys/BSPDriver/BSPCAN.c ****     }
 149:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	//模块未使能
 150:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	if(canNum == eCAN1 && 1 != gBSPFunCfg.Bits.CAN1En)
 151:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	{
 152:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		return(FALSE);
 153:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	}
 154:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	FDCAN_TxHeaderTypeDef TxHeader;
 155:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	/* Prepare Tx Header */
 156:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	TxHeader.Identifier = msg->ID;
 157:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	TxHeader.IdType = FDCAN_EXTENDED_ID;
 158:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	TxHeader.TxFrameType = FDCAN_DATA_FRAME;
 159:./Application/BSPSys/BSPDriver/BSPCAN.c ****         if(msg->Len<=8)
 160:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		TxHeader.DataLength =  msg->Len;
 161:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	if(msg->Len<=12&&msg->Len>8)
 162:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		TxHeader.DataLength = FDCAN_DLC_BYTES_12;
 163:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	if(msg->Len<=16&&msg->Len>12)
 164:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		TxHeader.DataLength = FDCAN_DLC_BYTES_16;
 165:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	if(msg->Len<=20&&msg->Len>16)
 166:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		TxHeader.DataLength = FDCAN_DLC_BYTES_20;
 167:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	if(msg->Len<=24&&msg->Len>20)
 168:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		TxHeader.DataLength = FDCAN_DLC_BYTES_24;
 169:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	if(msg->Len<=32&&msg->Len>24)
 170:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		TxHeader.DataLength = FDCAN_DLC_BYTES_32;
 171:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	if(msg->Len<=48&&msg->Len>32)
 172:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		TxHeader.DataLength = FDCAN_DLC_BYTES_48;
 173:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	if(msg->Len<=64&&msg->Len>48)
 174:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		TxHeader.DataLength = FDCAN_DLC_BYTES_64;
 175:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	TxHeader.ErrorStateIndicator = FDCAN_ESI_ACTIVE;
 176:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	TxHeader.BitRateSwitch = FDCAN_BRS_ON;
 177:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	TxHeader.FDFormat = FDCAN_FD_CAN;
 178:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	TxHeader.TxEventFifoControl = FDCAN_NO_TX_EVENTS;
 179:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	TxHeader.MessageMarker = 0;
 180:./Application/BSPSys/BSPDriver/BSPCAN.c **** 
 181:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	if(canNum == eCAN1)
 182:./Application/BSPSys/BSPDriver/BSPCAN.c ****     {	
 183:./Application/BSPSys/BSPDriver/BSPCAN.c ****       BSP_DISABLE_IRQ();//关中断，防止发送被打断
 184:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		if(HAL_OK != HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &TxHeader,msg->Data))
 185:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		{
 186:./Application/BSPSys/BSPDriver/BSPCAN.c **** 			failureCountCAN1++;
 187:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		     BSP_ENABLE_IRQ();//开中断
 188:./Application/BSPSys/BSPDriver/BSPCAN.c **** 			 if (failureCountCAN1 >= 50 )
 189:./Application/BSPSys/BSPDriver/BSPCAN.c **** 			 {
 190:./Application/BSPSys/BSPDriver/BSPCAN.c **** 				failureCountCAN1 = 0;//重置计数器
 191:./Application/BSPSys/BSPDriver/BSPCAN.c **** 				BSPCANInit(eCAN1);
 192:./Application/BSPSys/BSPDriver/BSPCAN.c **** 			 }
 193:./Application/BSPSys/BSPDriver/BSPCAN.c **** 			return(FALSE);
 194:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		}	
 195:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		BSP_ENABLE_IRQ();//开中断
 196:./Application/BSPSys/BSPDriver/BSPCAN.c ****     }
 197:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	return(TRUE);
ARM GAS  /tmp/cccdeKhJ.s 			page 5


 198:./Application/BSPSys/BSPDriver/BSPCAN.c **** }
 199:./Application/BSPSys/BSPDriver/BSPCAN.c **** 
 200:./Application/BSPSys/BSPDriver/BSPCAN.c **** /*=============================================================================================
 201:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @Name      : u8 BSPCANSendQin(e_CANNUM canNum, t_CANMSG *msg)
 202:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @Input     : canNum:通道号 *msg:发送信息结构体
 203:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @Output    : 发送结果:TRUE-成功 FALSE-失败
 204:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @Function  : CAN发送信息(数据压入队列)
 205:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @The notes : 用户调用
 206:./Application/BSPSys/BSPDriver/BSPCAN.c **** **===========================================================================================*/
 207:./Application/BSPSys/BSPDriver/BSPCAN.c **** u8 BSPCANSendQin(e_CANNUM canNum, t_CANMSG *msg)
 208:./Application/BSPSys/BSPDriver/BSPCAN.c **** {
 209:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	//模块未使能
 210:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	if(canNum != eCAN1 && 1 != gBSPFunCfg.Bits.CAN1En)
 211:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	{
 212:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		return(FALSE);
 213:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	}
 214:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	u8 result = 0;
 215:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	if(canNum >= eCANNUM)
 216:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	{
 217:./Application/BSPSys/BSPDriver/BSPCAN.c **** 		return(FALSE);
 218:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	}
 219:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	result = QueIn((void *)sCANSendBuff[canNum], (void *)(msg));
 220:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	
 221:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	return(result);
 222:./Application/BSPSys/BSPDriver/BSPCAN.c **** }
 223:./Application/BSPSys/BSPDriver/BSPCAN.c **** 
 224:./Application/BSPSys/BSPDriver/BSPCAN.c **** /*=============================================================================================
 225:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @Name      : void BSPCANSendTask(void)
 226:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @Input     : void
 227:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @Output    : void
 228:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @Function  : CAN信息发送任务
 229:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @The notes : BSP调用
 230:./Application/BSPSys/BSPDriver/BSPCAN.c **** **===========================================================================================*/
 231:./Application/BSPSys/BSPDriver/BSPCAN.c **** void BSPCANSendTask(void)
 232:./Application/BSPSys/BSPDriver/BSPCAN.c **** {
 233:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	u8 index = 0;
 234:./Application/BSPSys/BSPDriver/BSPCAN.c **** 	static t_CANMSG txMsg;
