  98:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @Input     : canNum:CAN通道号 osc:晶振频率 rate:CAN波特率
  99:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @Output    : 初始化结果 TRUE:成功 FALSE:失败
 100:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @Function  : CAN驱动模块初始化
 101:./Application/BSPSys/BSPDriver/BSPCAN.c **** ** @The notes : BSP调用
 102:./Application/BSPSys/BSPDriver/BSPCAN.c **** **===========================================================================================*/
 103:./Application/BSPSys/BSPDriver/BSPCAN.c **** void BSPCANInit(e_CANNUM canNum)
 104:./Application/BSPSys/BSPDriver/BSPCAN.c **** {	
 105:./Application/BSPSys/BSPDriver/BSPCAN.c ****     if(canNum >= eCANNUM)
 106:./Application/BSPSys/BSPDriver/BSPCAN.c ****     {
 107:./Application/BSPSys/BSPDriver/BSPCAN.c ****         return;
 108:./Application/BSPSys/BSPDriver/BSPCAN.c ****     }
 109:./Application/BSPSys/BSPDriver/BSPCAN.c ****     if((canNum == eCAN1)&&(1 != gBSPFunCfg.Bits.CAN1En))
 110:./Application/BSPSys/BSPDriver/BSPCAN.c ****     {
 111:./Application/BSPSys/BSPDriver/BSPCAN.c ****         return;
 112:./Application/BSPSys/BSPDriver/BSPCAN.c ****     }
 113:./Application/BSPSys/BSPDriver/BSPCAN.c ****     switch(canNum)
 114:./Application/BSPSys/BSPDriver/BSPCAN.c ****     {
 115:./Application/BSPSys/BSPDriver/BSPCAN.c ****         case eCAN1:
 116:./Application/BSPSys/BSPDriver/BSPCAN.c ****             if(1 == gBSPFunCfg.Bits.CAN1En)  
 117:./Application/BSPSys/BSPDriver/BSPCAN.c ****             {
 118:./Application/BSPSys/BSPDriver/BSPCAN.c ****                 MX_FDCAN1_Init();
 119:./Application/BSPSys/BSPDriver/BSPCAN.c ****                 // fdcan1_config();
 120:./Application/BSPSys/BSPDriver/BSPCAN.c ****             }           
 121:./Application/BSPSys/BSPDriver/BSPCAN.c ****            //计算can1波特率
 122:./Application/BSPSys/BSPDriver/BSPCAN.c ****            // BaudRate = HAL_RCC_GetPCLK1Freq()/1000;//单位k，获取apb1时钟频率
 123:./Application/BSPSys/BSPDriver/BSPCAN.c ****            // BaudRate = BaudRate/(2*hfdcan1.Init.ClockDivider);
 124:./Application/BSPSys/BSPDriver/BSPCAN.c ****            // BaudRate = BaudRate/(hfdcan1.Init.DataTimeSeg1 +  hfdcan1.Init.DataTimeSeg2 +1);
 125:./Application/BSPSys/BSPDriver/BSPCAN.c ****            // InputCANStateData(eCAN1 , BaudRate);
 126:./Application/BSPSys/BSPDriver/BSPCAN.c **** 
 127:./Application/BSPSys/BSPDriver/BSPCAN.c ****             break;    
 128:./Application/BSPSys/BSPDriver/BSPCAN.c ****         default:
 129:./Application/BSPSys/BSPDriver/BSPCAN.c ****         
 130:./Application/BSPSys/BSPDriver/BSPCAN.c ****             break;        
 131:./Application/BSPSys/BSPDriver/BSPCAN.c ****     }	
 132:./Application/BSPSys/BSPDriver/BSPCAN.c **** }
