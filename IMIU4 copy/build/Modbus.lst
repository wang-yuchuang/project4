  90:./Application/Addition/Modbus/Modbus.c **** /*=============================================================================================
  91:./Application/Addition/Modbus/Modbus.c **** ** @Name      : void Modbus_ToolingInterface(t_USARTMSG *pmsgData)
ARM GAS  /tmp/ccrwYaqM.s 			page 3


  92:./Application/Addition/Modbus/Modbus.c **** ** @Input     : 串口接收数据
  93:./Application/Addition/Modbus/Modbus.c **** ** @Output    : void
  94:./Application/Addition/Modbus/Modbus.c **** ** @Function  : 上位机通信主函数，解析报文并返回回复上位机的报文
  95:./Application/Addition/Modbus/Modbus.c **** ** @The notes : 
  96:./Application/Addition/Modbus/Modbus.c **** **===========================================================================================*/
  97:./Application/Addition/Modbus/Modbus.c **** void Modbus_ToolingInterface(t_USARTMSG *pmsgData)
  98:./Application/Addition/Modbus/Modbus.c **** {
  99:./Application/Addition/Modbus/Modbus.c **** 	if (pmsgData == NULL || pmsgData->len == 0) 
 100:./Application/Addition/Modbus/Modbus.c **** 	{
 101:./Application/Addition/Modbus/Modbus.c ****         return;
 102:./Application/Addition/Modbus/Modbus.c ****     }
 103:./Application/Addition/Modbus/Modbus.c **** 	//1. 解析数据
 104:./Application/Addition/Modbus/Modbus.c **** 	u8 status = Modbus_RTUProcess(pmsgData->data,&pstcModbus);
 105:./Application/Addition/Modbus/Modbus.c **** 
 106:./Application/Addition/Modbus/Modbus.c **** 	//根据解析结果进行读写操作 并 生成回复报文
 107:./Application/Addition/Modbus/Modbus.c **** 	if (status == MODBUS_OK)
 108:./Application/Addition/Modbus/Modbus.c **** 	{
 109:./Application/Addition/Modbus/Modbus.c **** 		//2. 读写操作
 110:./Application/Addition/Modbus/Modbus.c **** 		Modbus_ExecuteOperation(&pstcModbus);
 111:./Application/Addition/Modbus/Modbus.c **** 	}
 112:./Application/Addition/Modbus/Modbus.c **** 
 113:./Application/Addition/Modbus/Modbus.c **** 	// 3.生成回复报文
 114:./Application/Addition/Modbus/Modbus.c **** 	u8 bufReply[300];
 115:./Application/Addition/Modbus/Modbus.c ****     u8 lenReply = 0;
 116:./Application/Addition/Modbus/Modbus.c **** 	if (status == MODBUS_OK)
 117:./Application/Addition/Modbus/Modbus.c **** 	{
 118:./Application/Addition/Modbus/Modbus.c ****          lenReply = Modbus_BuildResponse(&pstcModbus, bufReply);
 119:./Application/Addition/Modbus/Modbus.c **** 	}
 120:./Application/Addition/Modbus/Modbus.c **** 	//错误回复报文
 121:./Application/Addition/Modbus/Modbus.c **** 	else 
 122:./Application/Addition/Modbus/Modbus.c **** 	{// 构建错误响应
 123:./Application/Addition/Modbus/Modbus.c ****         u8 *errorReply = Modbus_ErrorResponse(&pstcModbus, pmsgData->data);
 124:./Application/Addition/Modbus/Modbus.c ****         if (errorReply != NULL) 
 125:./Application/Addition/Modbus/Modbus.c **** 		{
 126:./Application/Addition/Modbus/Modbus.c ****             memcpy(bufReply, errorReply, 5);
 127:./Application/Addition/Modbus/Modbus.c ****             lenReply = 5;
 128:./Application/Addition/Modbus/Modbus.c **** 		}
 129:./Application/Addition/Modbus/Modbus.c **** 	}
 130:./Application/Addition/Modbus/Modbus.c **** 
 131:./Application/Addition/Modbus/Modbus.c **** 	if (lenReply > 0)
 132:./Application/Addition/Modbus/Modbus.c **** 	{
 133:./Application/Addition/Modbus/Modbus.c **** 		BSPUSARTSendQin(eUSART6, bufReply, lenReply); 
 134:./Application/Addition/Modbus/Modbus.c **** 	}
 135:./Application/Addition/Modbus/Modbus.c **** }
 136:./Application/Addition/Modbus/Modbus.c **** 
 137:./Application/Addition/Modbus/Modbus.c **** 
 138:./Application/Addition/Modbus/Modbus.c **** /*=============================================================================================
 139:./Application/Addition/Modbus/Modbus.c **** ** @Name      : u8 Test_LengthRecData(u8*pData)	
 140:./Application/Addition/Modbus/Modbus.c **** ** @Input     : 报文数据
 141:./Application/Addition/Modbus/Modbus.c **** ** @Output    : 报文长度
 142:./Application/Addition/Modbus/Modbus.c **** ** @Function  : modbus报文数据长度解析
 143:./Application/Addition/Modbus/Modbus.c **** ** @The notes : 
 144:./Application/Addition/Modbus/Modbus.c **** **===========================================================================================*/
 145:./Application/Addition/Modbus/Modbus.c **** u8 Test_LengthRecData(u8*pData)		
 146:./Application/Addition/Modbus/Modbus.c **** {
 147:./Application/Addition/Modbus/Modbus.c **** 	if(pData[1] == MODBUS_READ_HOLD_REG)		//读报文长度
 148:./Application/Addition/Modbus/Modbus.c **** 		{
ARM GAS  /tmp/ccrwYaqM.s 			page 4


 149:./Application/Addition/Modbus/Modbus.c **** 			return 8;					
 150:./Application/Addition/Modbus/Modbus.c **** 		}
 151:./Application/Addition/Modbus/Modbus.c **** 	if (pData[1] == MODBUS_WRITE_SIN_HOLD_REG) 
 152:./Application/Addition/Modbus/Modbus.c **** 		{
 153:./Application/Addition/Modbus/Modbus.c **** 			return 8;		
 154:./Application/Addition/Modbus/Modbus.c **** 		}
 155:./Application/Addition/Modbus/Modbus.c **** 		
 156:./Application/Addition/Modbus/Modbus.c **** 	if(pData[1] == MODBUS_WRITE_MULT_HOLD_REG)    //写报文长度
 157:./Application/Addition/Modbus/Modbus.c **** 		{
 158:./Application/Addition/Modbus/Modbus.c **** 			return (pData[4]<<8|pData[5])*2+9;
 159:./Application/Addition/Modbus/Modbus.c **** 		}	
 160:./Application/Addition/Modbus/Modbus.c ****         return false;
 161:./Application/Addition/Modbus/Modbus.c **** }
 162:./Application/Addition/Modbus/Modbus.c **** 
 163:./Application/Addition/Modbus/Modbus.c **** /*=============================================================================================
 164:./Application/Addition/Modbus/Modbus.c **** ** @Name      : static u8 Modbus_RTUProcess(void)
 165:./Application/Addition/Modbus/Modbus.c **** ** @Input     : void
 166:./Application/Addition/Modbus/Modbus.c **** ** @Output    : Modbus状态  
 167:./Application/Addition/Modbus/Modbus.c **** ** @Function  : modbus基础数据解析
 168:./Application/Addition/Modbus/Modbus.c **** ** @The notes : 
 169:./Application/Addition/Modbus/Modbus.c **** **===========================================================================================*/
 170:./Application/Addition/Modbus/Modbus.c **** static u8 Modbus_RTUProcess(u8 *rx_buf, stc_modbus *p_modbus)
 171:./Application/Addition/Modbus/Modbus.c **** {
 172:./Application/Addition/Modbus/Modbus.c **** 	memset(p_modbus, 0, sizeof(stc_modbus));
 173:./Application/Addition/Modbus/Modbus.c **** 	//获取报文完整长度
 174:./Application/Addition/Modbus/Modbus.c **** 	u8 rx_len;
 175:./Application/Addition/Modbus/Modbus.c **** 	rx_len = Test_LengthRecData(rx_buf);
 176:./Application/Addition/Modbus/Modbus.c **** 	
 177:./Application/Addition/Modbus/Modbus.c **** 	//1.基本报文长度检查
 178:./Application/Addition/Modbus/Modbus.c **** 	if (rx_len < 4)//地址+功能码+CRC最小长度
 179:./Application/Addition/Modbus/Modbus.c **** 	{
 180:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->error_code = MODBUS_ERR_DATA;
 181:./Application/Addition/Modbus/Modbus.c **** 		return MODBUS_ERR_DATA;
 182:./Application/Addition/Modbus/Modbus.c **** 	}
 183:./Application/Addition/Modbus/Modbus.c **** 	
 184:./Application/Addition/Modbus/Modbus.c **** 	//2. 解析报文
 185:./Application/Addition/Modbus/Modbus.c **** 	p_modbus->address = rx_buf[0];
 186:./Application/Addition/Modbus/Modbus.c **** 	p_modbus->functionCode = rx_buf[1];
 187:./Application/Addition/Modbus/Modbus.c **** 	p_modbus->reg_addr = (rx_buf[2] << 8) | rx_buf[3];
 188:./Application/Addition/Modbus/Modbus.c **** 	p_modbus->data_len = rx_len;
 189:./Application/Addition/Modbus/Modbus.c **** 	p_modbus->crc = (rx_buf[rx_len - 2] << 8) | rx_buf[rx_len - 1];
 190:./Application/Addition/Modbus/Modbus.c **** 
 191:./Application/Addition/Modbus/Modbus.c **** 	//3. 地址是否正确
 192:./Application/Addition/Modbus/Modbus.c **** 	if ((p_modbus->address != Slave1_Address))
 193:./Application/Addition/Modbus/Modbus.c **** 	{
 194:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->error_code = MODBUS_ERR_ADDRESS;
 195:./Application/Addition/Modbus/Modbus.c **** 		return MODBUS_ERR_ADDRESS;
 196:./Application/Addition/Modbus/Modbus.c **** 	}
 197:./Application/Addition/Modbus/Modbus.c **** 
 198:./Application/Addition/Modbus/Modbus.c **** 	//4. 检测寄存器地址是否正确
 199:./Application/Addition/Modbus/Modbus.c **** 	if (p_modbus->reg_addr >= MAX_HOLDING_REGS)
 200:./Application/Addition/Modbus/Modbus.c **** 	{
 201:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->error_code = MODBUS_ERR_REG_ADDR;
 202:./Application/Addition/Modbus/Modbus.c **** 		return MODBUS_ERR_REG_ADDR;
 203:./Application/Addition/Modbus/Modbus.c **** 	}
 204:./Application/Addition/Modbus/Modbus.c **** 	
 205:./Application/Addition/Modbus/Modbus.c **** 	//5. CRC校验是否正确
ARM GAS  /tmp/ccrwYaqM.s 			page 5


 206:./Application/Addition/Modbus/Modbus.c **** 	u16 calc_crc  =  ModbusCrc(rx_buf, rx_len - 2);
 207:./Application/Addition/Modbus/Modbus.c **** 	if (calc_crc != p_modbus->crc)
 208:./Application/Addition/Modbus/Modbus.c **** 	{
 209:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->error_code = MODBUS_ERR_CRC;
 210:./Application/Addition/Modbus/Modbus.c **** 		return MODBUS_ERR_CRC;
 211:./Application/Addition/Modbus/Modbus.c **** 	}
 212:./Application/Addition/Modbus/Modbus.c **** 
 213:./Application/Addition/Modbus/Modbus.c **** 	//根据功能码解析数据域
 214:./Application/Addition/Modbus/Modbus.c **** 	return Modbus_ParsingFrame(rx_buf,rx_len,p_modbus);
 215:./Application/Addition/Modbus/Modbus.c **** 
 216:./Application/Addition/Modbus/Modbus.c **** }
 217:./Application/Addition/Modbus/Modbus.c **** 
 218:./Application/Addition/Modbus/Modbus.c **** /*=============================================================================================
 219:./Application/Addition/Modbus/Modbus.c **** ** @Name      : static u8 Modbus_ParsingFrame(u8 *rx_buf, u8 rx_len, stc_modbus *p_modbus)
 220:./Application/Addition/Modbus/Modbus.c **** ** @Input     : 报文数据 报文数据长度 modbus结构体
 221:./Application/Addition/Modbus/Modbus.c **** ** @Output    : Modbus状态  
 222:./Application/Addition/Modbus/Modbus.c **** ** @Function  : modbus功能码解析 
 223:./Application/Addition/Modbus/Modbus.c **** ** @The notes : 
 224:./Application/Addition/Modbus/Modbus.c **** **===========================================================================================*/
 225:./Application/Addition/Modbus/Modbus.c **** static u8 Modbus_ParsingFrame(u8 *rx_buf, u8 rx_len, stc_modbus *p_modbus)
 226:./Application/Addition/Modbus/Modbus.c **** {
 227:./Application/Addition/Modbus/Modbus.c **** 	u8 func_code = p_modbus->functionCode;
 228:./Application/Addition/Modbus/Modbus.c **** 
 229:./Application/Addition/Modbus/Modbus.c **** 	switch (func_code)
 230:./Application/Addition/Modbus/Modbus.c **** 	{
 231:./Application/Addition/Modbus/Modbus.c **** 	//0x03
 232:./Application/Addition/Modbus/Modbus.c **** 	case MODBUS_READ_HOLD_REG: 
 233:./Application/Addition/Modbus/Modbus.c **** 		if (rx_len != 8) // 固定长度：地址+功能码+起始地址(2)+数量(2)+CRC(2)
 234:./Application/Addition/Modbus/Modbus.c **** 		{
 235:./Application/Addition/Modbus/Modbus.c **** 			p_modbus->error_code = MODBUS_ERR_DATA;
 236:./Application/Addition/Modbus/Modbus.c **** 			return MODBUS_ERR_DATA;
 237:./Application/Addition/Modbus/Modbus.c **** 		}
 238:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->reg_addr = (rx_buf[2] << 8) | rx_buf[3];
 239:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->reg_num  = (rx_buf[4] << 8) | rx_buf[5];
 240:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->data_len = 0;  // 请求无数据
 241:./Application/Addition/Modbus/Modbus.c **** 		//对读取地址添加边界检查
 242:./Application/Addition/Modbus/Modbus.c **** 		if (p_modbus->reg_addr > MAX_HOLDING_REGS)
 243:./Application/Addition/Modbus/Modbus.c **** 		{
 244:./Application/Addition/Modbus/Modbus.c **** 			p_modbus->error_code = MODBUS_ERR_REG_ADDR;
 245:./Application/Addition/Modbus/Modbus.c **** 			return MODBUS_ERR_REG_ADDR;
 246:./Application/Addition/Modbus/Modbus.c **** 		}
 247:./Application/Addition/Modbus/Modbus.c **** 		//对读取数量添加边界检查
 248:./Application/Addition/Modbus/Modbus.c **** 		if((p_modbus->reg_num == 0) || (p_modbus->reg_num > MAX_HOLDING_REGS))
 249:./Application/Addition/Modbus/Modbus.c **** 		{
 250:./Application/Addition/Modbus/Modbus.c **** 			p_modbus->error_code = MODBUS_ERR_REG_NUM;
 251:./Application/Addition/Modbus/Modbus.c **** 			return MODBUS_ERR_REG_NUM;
 252:./Application/Addition/Modbus/Modbus.c **** 		}
 253:./Application/Addition/Modbus/Modbus.c **** 		break;
 254:./Application/Addition/Modbus/Modbus.c **** 
 255:./Application/Addition/Modbus/Modbus.c **** 	//0x06
 256:./Application/Addition/Modbus/Modbus.c **** 	case MODBUS_WRITE_SIN_HOLD_REG:
 257:./Application/Addition/Modbus/Modbus.c **** 		 if (rx_len != 8) {
 258:./Application/Addition/Modbus/Modbus.c **** 			p_modbus->error_code = MODBUS_ERR_DATA;
 259:./Application/Addition/Modbus/Modbus.c ****                 return MODBUS_ERR_DATA;
 260:./Application/Addition/Modbus/Modbus.c ****             }
 261:./Application/Addition/Modbus/Modbus.c ****             p_modbus->reg_addr = (rx_buf[2] << 8) | rx_buf[3];
 262:./Application/Addition/Modbus/Modbus.c ****             p_modbus->reg_num = 1;
ARM GAS  /tmp/ccrwYaqM.s 			page 6


 263:./Application/Addition/Modbus/Modbus.c ****             // 存储要写入的数据
 264:./Application/Addition/Modbus/Modbus.c ****             p_modbus->registers[0][0] = rx_buf[4];  // 存储到临时缓冲区索引0
 265:./Application/Addition/Modbus/Modbus.c **** 			p_modbus->registers[0][1] = rx_buf[5];
 266:./Application/Addition/Modbus/Modbus.c ****             p_modbus->data_len = 2;
 267:./Application/Addition/Modbus/Modbus.c ****             break;
 268:./Application/Addition/Modbus/Modbus.c **** 	//0x10 
 269:./Application/Addition/Modbus/Modbus.c **** 	case MODBUS_WRITE_MULT_HOLD_REG://写多个保持寄存器
 270:./Application/Addition/Modbus/Modbus.c **** 			p_modbus->reg_addr = (rx_buf[2] << 8) | rx_buf[3];
 271:./Application/Addition/Modbus/Modbus.c **** 			p_modbus->reg_num = (rx_buf[4] << 8) | rx_buf[5];
 272:./Application/Addition/Modbus/Modbus.c **** 			p_modbus->data_len = rx_buf[6];  // 字节数
 273:./Application/Addition/Modbus/Modbus.c **** 	
 274:./Application/Addition/Modbus/Modbus.c **** 	// 检查数据长度是否匹配
 275:./Application/Addition/Modbus/Modbus.c **** 	if (rx_len != (9 + p_modbus->data_len)) {
 276:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->error_code = MODBUS_ERR_DATA;
 277:./Application/Addition/Modbus/Modbus.c **** 		return MODBUS_ERR_DATA;
 278:./Application/Addition/Modbus/Modbus.c **** 	}
 279:./Application/Addition/Modbus/Modbus.c **** 	for (u16 j = 0; j < p_modbus->reg_num; j++) {
 280:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->registers[j][0] = rx_buf[7 + j * 2];  // 第j个寄存器的高字节
 281:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->registers[j][1] = rx_buf[8 + j * 2];  // 第j个寄存器的低字节
 282:./Application/Addition/Modbus/Modbus.c **** 	}
 283:./Application/Addition/Modbus/Modbus.c **** 	break;
 284:./Application/Addition/Modbus/Modbus.c **** 
 285:./Application/Addition/Modbus/Modbus.c **** 	default:
 286:./Application/Addition/Modbus/Modbus.c **** 	p_modbus->error_code = MODBUS_ERR_FUNC_CODE;
 287:./Application/Addition/Modbus/Modbus.c **** 	return MODBUS_ERR_FUNC_CODE;
 288:./Application/Addition/Modbus/Modbus.c **** 	}
 289:./Application/Addition/Modbus/Modbus.c **** 
 290:./Application/Addition/Modbus/Modbus.c **** 	return MODBUS_OK;
 291:./Application/Addition/Modbus/Modbus.c **** 
 292:./Application/Addition/Modbus/Modbus.c **** }
 293:./Application/Addition/Modbus/Modbus.c **** /*=============================================================================================
 294:./Application/Addition/Modbus/Modbus.c **** ** @Name      : static u8 Modbus_ExecuteOperation(stc_modbus *p_modbus)
 295:./Application/Addition/Modbus/Modbus.c **** ** @Input     : modbus结构体
 296:./Application/Addition/Modbus/Modbus.c **** ** @Output    : modbus状态
 297:./Application/Addition/Modbus/Modbus.c **** ** @Function  : 执行操作,根据解析后得到的modbus请求，执行相应的寄存器读写�
 298:./Application/Addition/Modbus/Modbus.c **** ** @The notes : 
 299:./Application/Addition/Modbus/Modbus.c **** **===========================================================================================*/
 300:./Application/Addition/Modbus/Modbus.c **** static u8 Modbus_ExecuteOperation(stc_modbus *p_modbus)
 301:./Application/Addition/Modbus/Modbus.c **** {
 302:./Application/Addition/Modbus/Modbus.c **** 	u8 func_code = p_modbus->functionCode;
 303:./Application/Addition/Modbus/Modbus.c **** 	u16 reg_addr  = p_modbus->reg_addr;
 304:./Application/Addition/Modbus/Modbus.c **** 	u16 reg_num   = p_modbus->reg_num;
 305:./Application/Addition/Modbus/Modbus.c **** 
 306:./Application/Addition/Modbus/Modbus.c **** 	if (p_modbus->error_code != MODBUS_OK)
 307:./Application/Addition/Modbus/Modbus.c **** 	{
 308:./Application/Addition/Modbus/Modbus.c **** 		return p_modbus->error_code;
 309:./Application/Addition/Modbus/Modbus.c **** 	}
 310:./Application/Addition/Modbus/Modbus.c **** 
 311:./Application/Addition/Modbus/Modbus.c **** 	switch (func_code)
 312:./Application/Addition/Modbus/Modbus.c **** 	{
 313:./Application/Addition/Modbus/Modbus.c **** 		//读保持寄存器03
 314:./Application/Addition/Modbus/Modbus.c **** 	case MODBUS_READ_HOLD_REG:
 315:./Application/Addition/Modbus/Modbus.c **** 		for (u16 i = 0; i < reg_num; i++) {
 316:./Application/Addition/Modbus/Modbus.c **** 			u16 actual_reg_addr = reg_addr + i;
 317:./Application/Addition/Modbus/Modbus.c **** 			if (actual_reg_addr < MAX_HOLDING_REGS) {  
 318:./Application/Addition/Modbus/Modbus.c **** 				p_modbus->registers[i][0] = ModbusReg[actual_reg_addr][0];
 319:./Application/Addition/Modbus/Modbus.c **** 				p_modbus->registers[i][1] = ModbusReg[actual_reg_addr][1];
ARM GAS  /tmp/ccrwYaqM.s 			page 7


 320:./Application/Addition/Modbus/Modbus.c **** 			} else {
 321:./Application/Addition/Modbus/Modbus.c **** 				// 寄存器地址无效
 322:./Application/Addition/Modbus/Modbus.c **** 				p_modbus->registers[i][0] = 0;
 323:./Application/Addition/Modbus/Modbus.c **** 				p_modbus->registers[i][1] = 0;
 324:./Application/Addition/Modbus/Modbus.c **** 			}
 325:./Application/Addition/Modbus/Modbus.c **** 		}
 326:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->data_len = reg_num * 2;
 327:./Application/Addition/Modbus/Modbus.c **** 	break;
 328:./Application/Addition/Modbus/Modbus.c **** 		
 329:./Application/Addition/Modbus/Modbus.c **** 	case MODBUS_WRITE_SIN_HOLD_REG:
 330:./Application/Addition/Modbus/Modbus.c **** 		// 写入单个保持寄存器06
 331:./Application/Addition/Modbus/Modbus.c **** 		ModbusReg[reg_addr][0] = p_modbus->registers[0][0];
 332:./Application/Addition/Modbus/Modbus.c **** 		ModbusReg[reg_addr][1] = p_modbus->registers[0][1];
 333:./Application/Addition/Modbus/Modbus.c **** 		
 334:./Application/Addition/Modbus/Modbus.c **** 		// 更新寄存器值到p_modbus->registers（用于响应）
 335:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->registers[0][0] = ModbusReg[reg_addr][0];
 336:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->registers[0][1] = ModbusReg[reg_addr][1];
 337:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->data_len = 2;
 338:./Application/Addition/Modbus/Modbus.c **** 		break;
 339:./Application/Addition/Modbus/Modbus.c **** 		
 340:./Application/Addition/Modbus/Modbus.c **** 	case MODBUS_WRITE_MULT_HOLD_REG:
 341:./Application/Addition/Modbus/Modbus.c **** 		// 写入连续保持寄存器10
 342:./Application/Addition/Modbus/Modbus.c **** 		for (u16 i = 0; i < reg_num; i++) {
 343:./Application/Addition/Modbus/Modbus.c **** 			u16 actual_reg_addr = reg_addr + i;
 344:./Application/Addition/Modbus/Modbus.c **** 			ModbusReg[actual_reg_addr][0] = p_modbus->registers[i][0];
 345:./Application/Addition/Modbus/Modbus.c **** 			ModbusReg[actual_reg_addr][1] = p_modbus->registers[i][1];
 346:./Application/Addition/Modbus/Modbus.c **** 		}
 347:./Application/Addition/Modbus/Modbus.c **** 		// 对于0x10功能码，响应中不需要寄存器数据
 348:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->data_len = 0;
 349:./Application/Addition/Modbus/Modbus.c **** 		break;
 350:./Application/Addition/Modbus/Modbus.c **** 	
 351:./Application/Addition/Modbus/Modbus.c **** 	default:
 352:./Application/Addition/Modbus/Modbus.c **** 		p_modbus->error_code = MODBUS_ERR_FUNC_CODE;
 353:./Application/Addition/Modbus/Modbus.c **** 		return MODBUS_ERR_FUNC_CODE;
 354:./Application/Addition/Modbus/Modbus.c **** 	}
 355:./Application/Addition/Modbus/Modbus.c **** 	return p_modbus->error_code;
 356:./Application/Addition/Modbus/Modbus.c **** }
 357:./Application/Addition/Modbus/Modbus.c **** 
 358:./Application/Addition/Modbus/Modbus.c **** /*=============================================================================================
 359:./Application/Addition/Modbus/Modbus.c **** ** @Name      : static u8 Modbus_BuildResponse(stc_modbus *p_modbus, u8 *bufReply)
 360:./Application/Addition/Modbus/Modbus.c **** ** @Input     : modbus结构体 
 361:./Application/Addition/Modbus/Modbus.c **** ** @Output    : 回复报文长度pos
 362:./Application/Addition/Modbus/Modbus.c **** ** @Function  : 输出请求和要返回的数据，输出缓存区
 363:./Application/Addition/Modbus/Modbus.c **** ** @The notes : 
 364:./Application/Addition/Modbus/Modbus.c **** **===========================================================================================*/
 365:./Application/Addition/Modbus/Modbus.c **** static u8 Modbus_BuildResponse(stc_modbus *p_modbus, u8 *bufReply)
 366:./Application/Addition/Modbus/Modbus.c **** {
 367:./Application/Addition/Modbus/Modbus.c ****     u8 pos = 0;
 368:./Application/Addition/Modbus/Modbus.c ****     
 369:./Application/Addition/Modbus/Modbus.c ****     // 1. 地址和功能码
 370:./Application/Addition/Modbus/Modbus.c ****     bufReply[pos++] = p_modbus->address;
 371:./Application/Addition/Modbus/Modbus.c ****     
 372:./Application/Addition/Modbus/Modbus.c ****     // 检查是否有错误
 373:./Application/Addition/Modbus/Modbus.c ****     if (p_modbus->error_code != MODBUS_OK) {
 374:./Application/Addition/Modbus/Modbus.c ****         bufReply[pos++] = p_modbus->functionCode | 0x80;  // 异常响应
 375:./Application/Addition/Modbus/Modbus.c ****         bufReply[pos++] = p_modbus->error_code;
 376:./Application/Addition/Modbus/Modbus.c ****     } else {
ARM GAS  /tmp/ccrwYaqM.s 			page 8


 377:./Application/Addition/Modbus/Modbus.c ****         bufReply[pos++] = p_modbus->functionCode;
 378:./Application/Addition/Modbus/Modbus.c ****         
 379:./Application/Addition/Modbus/Modbus.c ****         // 2. 根据功能码填充数据
 380:./Application/Addition/Modbus/Modbus.c ****         switch (p_modbus->functionCode) {
 381:./Application/Addition/Modbus/Modbus.c ****             case MODBUS_READ_HOLD_REG:  // 读保持寄存器响应
 382:./Application/Addition/Modbus/Modbus.c **** 					bufReply[pos++] = p_modbus->data_len;  // 字节数
 383:./Application/Addition/Modbus/Modbus.c ****                 // 复制寄存器数据
 384:./Application/Addition/Modbus/Modbus.c ****                 for (u16 i = 0; i < p_modbus->reg_num; i++) {
 385:./Application/Addition/Modbus/Modbus.c ****                     bufReply[pos++] = p_modbus->registers[i][0];  // 高字节
 386:./Application/Addition/Modbus/Modbus.c ****                     bufReply[pos++] = p_modbus->registers[i][1];  // 低字节
 387:./Application/Addition/Modbus/Modbus.c ****                 }
 388:./Application/Addition/Modbus/Modbus.c ****                 break;
 389:./Application/Addition/Modbus/Modbus.c ****                 
 390:./Application/Addition/Modbus/Modbus.c ****             case MODBUS_WRITE_SIN_HOLD_REG:  // 写单个寄存器响应
 391:./Application/Addition/Modbus/Modbus.c **** 				bufReply[pos++] = (u8)(p_modbus->reg_addr >> 8);
 392:./Application/Addition/Modbus/Modbus.c **** 				bufReply[pos++] = (u8)(p_modbus->reg_addr & 0xFF);
 393:./Application/Addition/Modbus/Modbus.c **** 				bufReply[pos++] = p_modbus->registers[0][0];  // 高字节
 394:./Application/Addition/Modbus/Modbus.c **** 				bufReply[pos++] = p_modbus->registers[0][1];  // 低字节
 395:./Application/Addition/Modbus/Modbus.c ****                 break;
 396:./Application/Addition/Modbus/Modbus.c ****                 
 397:./Application/Addition/Modbus/Modbus.c ****             case MODBUS_WRITE_MULT_HOLD_REG:  // 写多个寄存器响应
 398:./Application/Addition/Modbus/Modbus.c **** 				bufReply[pos++] = (u8)(p_modbus->reg_addr >> 8);
 399:./Application/Addition/Modbus/Modbus.c **** 				bufReply[pos++] = (u8)(p_modbus->reg_addr & 0xFF);
 400:./Application/Addition/Modbus/Modbus.c **** 				bufReply[pos++] = (u8)(p_modbus->reg_num >> 8);
 401:./Application/Addition/Modbus/Modbus.c **** 				bufReply[pos++] = (u8)(p_modbus->reg_num & 0xFF);
 402:./Application/Addition/Modbus/Modbus.c ****                 break;
 403:./Application/Addition/Modbus/Modbus.c ****         }
 404:./Application/Addition/Modbus/Modbus.c ****     }
 405:./Application/Addition/Modbus/Modbus.c ****     
 406:./Application/Addition/Modbus/Modbus.c ****     // 3. 计算CRC
 407:./Application/Addition/Modbus/Modbus.c ****     u16 crc = ModbusCrc(bufReply, pos);
 408:./Application/Addition/Modbus/Modbus.c ****     bufReply[pos++] = (u8)((crc >> 8)& 0xFF);
 409:./Application/Addition/Modbus/Modbus.c ****     bufReply[pos++] = (u8)(crc)& 0xFF;
 410:./Application/Addition/Modbus/Modbus.c ****     
 411:./Application/Addition/Modbus/Modbus.c ****     return pos;  // 返回帧长度
 412:./Application/Addition/Modbus/Modbus.c **** }
 413:./Application/Addition/Modbus/Modbus.c **** 
