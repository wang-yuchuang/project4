 438:./Application/Addition/Modbus/Modbus.c **** 		reply[1] = p_modbus->functionCode | 0x80;		//最高位置一
 439:./Application/Addition/Modbus/Modbus.c **** 		reply[2] = p_modbus->error_code;
 440:./Application/Addition/Modbus/Modbus.c **** 		crc = ModbusCrc(reply, 3);	
 441:./Application/Addition/Modbus/Modbus.c **** 		reply[3] =  (crc >> 8) & 0xFF;
 442:./Application/Addition/Modbus/Modbus.c **** 		reply[4] =	crc & 0xFF;
 443:./Application/Addition/Modbus/Modbus.c **** 		return reply;	
