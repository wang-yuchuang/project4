 445:./Application/Addition/Modbus/Modbus.c **** 	case MODBUS_ERR_CRC:
 446:./Application/Addition/Modbus/Modbus.c **** 		reply[0] = p_modbus->address;
 447:./Application/Addition/Modbus/Modbus.c **** 		reply[1] = p_modbus->functionCode | 0x80;		//最高位置一
 448:./Application/Addition/Modbus/Modbus.c **** 		reply[2] = p_modbus->error_code;
 449:./Application/Addition/Modbus/Modbus.c **** 		crc = ModbusCrc(reply, 3);	
 450:./Application/Addition/Modbus/Modbus.c **** 		reply[3] =  (crc >> 8) & 0xFF;
 451:./Application/Addition/Modbus/Modbus.c **** 		reply[4] =	crc & 0xFF;
 452:./Application/Addition/Modbus/Modbus.c **** 		return reply;	
 453:./Application/Addition/Modbus/Modbus.c **** 		
 454:./Application/Addition/Modbus/Modbus.c **** 	default:
