 333:./Application/Funtion/SystemPara/SystemPara.c **** /*=================================================================================================
 334:./Application/Funtion/SystemPara/SystemPara.c **** ** @Name      : u8 RcvSystemGenParaCfgAPI(u8 index, u8 port)
 335:./Application/Funtion/SystemPara/SystemPara.c **** ** @Input     : index:参数字段索引号 port:接收命令端口:[0,4]CAN口 [5,9]RS485口
 336:./Application/Funtion/SystemPara/SystemPara.c **** ** @Output    : 设置成功或失败
 337:./Application/Funtion/SystemPara/SystemPara.c **** ** @Function  : 系统通用参数设置命令处理函数
 338:./Application/Funtion/SystemPara/SystemPara.c **** ** @The notes : 通信口设置
 339:./Application/Funtion/SystemPara/SystemPara.c **** **===============================================================================================*/
 340:./Application/Funtion/SystemPara/SystemPara.c **** u8 RcvSystemGenParaCfgAPI(u8 index, u8 port)
 341:./Application/Funtion/SystemPara/SystemPara.c **** {
 342:./Application/Funtion/SystemPara/SystemPara.c ****     u16 para = 0;
 343:./Application/Funtion/SystemPara/SystemPara.c **** 
 344:./Application/Funtion/SystemPara/SystemPara.c ****     /*索引正确*/
 345:./Application/Funtion/SystemPara/SystemPara.c ****     if(index < Parameter_Len)
 346:./Application/Funtion/SystemPara/SystemPara.c ****     {
 347:./Application/Funtion/SystemPara/SystemPara.c ****     	para = ParameterSet_107[index];
 348:./Application/Funtion/SystemPara/SystemPara.c **** 
 349:./Application/Funtion/SystemPara/SystemPara.c ****         /*写入成功*/
 350:./Application/Funtion/SystemPara/SystemPara.c ****    	if(TRUE == ParaWriteStoreSystemGenParaInfo(index, para))
 351:./Application/Funtion/SystemPara/SystemPara.c ****        {
 352:./Application/Funtion/SystemPara/SystemPara.c ****    		/*显示区索引*/
 353:./Application/Funtion/SystemPara/SystemPara.c ****            if(index < Parameter_Len)
 354:./Application/Funtion/SystemPara/SystemPara.c ****            {
 355:./Application/Funtion/SystemPara/SystemPara.c ****                stParameter.u16ArraySet[index] = para;/*同步更新RAM参数*/
 356:./Application/Funtion/SystemPara/SystemPara.c ****            	   ParameterNow_102[index] = para;
 357:./Application/Funtion/SystemPara/SystemPara.c ****            }
 358:./Application/Funtion/SystemPara/SystemPara.c ****            else
 359:./Application/Funtion/SystemPara/SystemPara.c ****            {
 360:./Application/Funtion/SystemPara/SystemPara.c ****                 return(FALSE);
 361:./Application/Funtion/SystemPara/SystemPara.c ****            }
 362:./Application/Funtion/SystemPara/SystemPara.c **** 
 363:./Application/Funtion/SystemPara/SystemPara.c ****            return(TRUE);
 364:./Application/Funtion/SystemPara/SystemPara.c ****        }
 365:./Application/Funtion/SystemPara/SystemPara.c ****     }
 366:./Application/Funtion/SystemPara/SystemPara.c **** 
 367:./Application/Funtion/SystemPara/SystemPara.c ****     return(FALSE);
 368:./Application/Funtion/SystemPara/SystemPara.c **** }
