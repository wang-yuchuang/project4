  92:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c **** uint8_t BSP_GD25Qx_WriteEnable(void)
  93:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c **** {
  94:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****     uint8_t cmd[] = {WRITE_ENABLE_CMD};
  95:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****     uint32_t count = 0;
  96:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****     /*Select the FLASH: Chip Select low */
  97:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****     GD25Qx_Enable();
  98:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****     /* Send the read ID command */
  99:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****     HAL_SPI_Transmit(&hspi1, cmd, 1, GD25Qx_TIMEOUT_VALUE);    
 100:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****     /*Deselect the FLASH: Chip Select high */
 101:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****     GD25Qx_Disable();
 102:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c **** 
 103:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****     /* Wait the end of Flash writing */
 104:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****     while(BSP_GD25Qx_GetStatus() == GD25Qx_BUSY)
 105:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****     {
 106:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****         /* Check for the Timeout */
 107:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****         count++;
 108:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****         if(count > GD25Qx_GETSTATE_COUNT)
 109:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****         {        
 110:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****             return GD25Qx_TIMEOUT;
 111:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****         }
 112:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****     }
 113:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c **** 
 114:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c ****     return GD25Qx_OK;
 115:./Application/BSPSys/BSPDevice/gd25q32e/BSPGD25Q32E.c **** }
