  88:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Input     : swhSort:接触器名称[0,11] state:控制接触器状态 0:断开 1:闭合
  89:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Output    : void
  90:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Function  : 故障诊断滤波初始化
  91:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @The notes : 滤波处理数组清零
ARM GAS  /tmp/ccW036vO.s 			page 3


  92:./Application/Funtion/SystemDiag/SystemDiag.c **** **===============================================================================================*/
  93:./Application/Funtion/SystemDiag/SystemDiag.c **** void DiagErrFilterInit(void)
  94:./Application/Funtion/SystemDiag/SystemDiag.c **** {
  95:./Application/Funtion/SystemDiag/SystemDiag.c **** 	e_ERR_ID i = eERR_ID_FINISH;
  96:./Application/Funtion/SystemDiag/SystemDiag.c **** 
  97:./Application/Funtion/SystemDiag/SystemDiag.c **** 	/*所有故障位*/
  98:./Application/Funtion/SystemDiag/SystemDiag.c **** 	for(i = (e_ERR_ID)0; i < eERR_ID_FINISH; i++)
  99:./Application/Funtion/SystemDiag/SystemDiag.c **** 	{
 100:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    /*根据故障检测类型设置是否使能故障检测*/
 101:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    if(gErrFilPara[i].errSort > 0)
 102:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    {
 103:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        gErrFilTab[i].enable = 1;
 104:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    }
 105:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    else
 106:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    {
 107:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        gErrFilTab[i].enable = 0;
 108:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    }
 109:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 110:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    /*复位所有故障滤波参数*/
 111:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    gErrFilTab[i].nowState = eErr_A;
 112:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    gErrFilTab[i].filState = eErr_A;
 113:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    gErrFilTab[i].resTimes = 0;
 114:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    gErrFilTab[i].timer = 0;
 115:./Application/Funtion/SystemDiag/SystemDiag.c **** 	}
 116:./Application/Funtion/SystemDiag/SystemDiag.c **** }
 117:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 118:./Application/Funtion/SystemDiag/SystemDiag.c **** /*=================================================================================================
 119:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Name      : e_ErrSort DiagGetGroupNowErrLevelAPI(void)
 120:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Input     : void
 121:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Output    : 当前故障级别[0,8]
 122:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Function  : 获取当前故障级别
 123:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @The notes : 当前故障的最高级别
 124:./Application/Funtion/SystemDiag/SystemDiag.c **** **===============================================================================================*/
 125:./Application/Funtion/SystemDiag/SystemDiag.c **** e_ErrSort DiagGetGroupNowErrLevelAPI(void)
 126:./Application/Funtion/SystemDiag/SystemDiag.c **** {
 127:./Application/Funtion/SystemDiag/SystemDiag.c **** 	e_ERR_ID i = eERR_ID_FINISH;
 128:./Application/Funtion/SystemDiag/SystemDiag.c **** 	e_ErrSort sort = eErr_Norm;
 129:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 130:./Application/Funtion/SystemDiag/SystemDiag.c ****     for(i = (e_ERR_ID)0; i < eERR_ID_FINISH; i++)
 131:./Application/Funtion/SystemDiag/SystemDiag.c ****     {
 132:./Application/Funtion/SystemDiag/SystemDiag.c ****         if(eErr_Norm == DiagGetFilErrSortAPI(i))            /*不检测类型故障*/
 133:./Application/Funtion/SystemDiag/SystemDiag.c ****         {
 134:./Application/Funtion/SystemDiag/SystemDiag.c ****             ;                                               /*无故障*/
 135:./Application/Funtion/SystemDiag/SystemDiag.c ****         }
 136:./Application/Funtion/SystemDiag/SystemDiag.c ****         else if(eErr_Warm == DiagGetFilErrSortAPI(i))       /*提示类型故障*/
 137:./Application/Funtion/SystemDiag/SystemDiag.c ****         {
 138:./Application/Funtion/SystemDiag/SystemDiag.c ****             if(eErr_B == DiagGetErrLastStateAPI(i))         /*出现提示类异常*/
 139:./Application/Funtion/SystemDiag/SystemDiag.c ****             {
 140:./Application/Funtion/SystemDiag/SystemDiag.c ****                 if(sort < eErr_Warm)                        /*未检测到级别更高的异常*/
 141:./Application/Funtion/SystemDiag/SystemDiag.c ****                 {
 142:./Application/Funtion/SystemDiag/SystemDiag.c ****                     sort = eErr_Warm;                       /*设置为提示级别类型*/
 143:./Application/Funtion/SystemDiag/SystemDiag.c ****                 }
 144:./Application/Funtion/SystemDiag/SystemDiag.c ****             }
 145:./Application/Funtion/SystemDiag/SystemDiag.c ****         }
 146:./Application/Funtion/SystemDiag/SystemDiag.c ****         else if(eErr_SysErr == DiagGetFilErrSortAPI(i))     /*故障类型故障*/
 147:./Application/Funtion/SystemDiag/SystemDiag.c ****         {
 148:./Application/Funtion/SystemDiag/SystemDiag.c ****             if(eErr_B == DiagGetErrLastStateAPI(i))         /*出现停机类异常*/
ARM GAS  /tmp/ccW036vO.s 			page 4


 149:./Application/Funtion/SystemDiag/SystemDiag.c ****             {
 150:./Application/Funtion/SystemDiag/SystemDiag.c ****                 sort = eErr_SysErr;                         /*设置为停机级别类型*/
 151:./Application/Funtion/SystemDiag/SystemDiag.c ****                 break;                                      /*已是最高级,不需再检测*/
 152:./Application/Funtion/SystemDiag/SystemDiag.c ****             }
 153:./Application/Funtion/SystemDiag/SystemDiag.c ****         }
 154:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 155:./Application/Funtion/SystemDiag/SystemDiag.c ****     }
 156:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 157:./Application/Funtion/SystemDiag/SystemDiag.c ****     return(sort);
 158:./Application/Funtion/SystemDiag/SystemDiag.c **** }
