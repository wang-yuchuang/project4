 280:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Name      : void DiagSetErrNowStateAPI(e_ERR_ID id, e_ErrState state)
 281:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Input     : id:故障ID state:目标故障状态
 282:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Output    : void
 283:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Function  : 设置故障诊断滤波当前瞬时状态
 284:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @The notes :
 285:./Application/Funtion/SystemDiag/SystemDiag.c **** **===============================================================================================*/
 286:./Application/Funtion/SystemDiag/SystemDiag.c **** void DiagSetErrNowStateAPI(e_ERR_ID id, e_ErrState state)
 287:./Application/Funtion/SystemDiag/SystemDiag.c **** {
 288:./Application/Funtion/SystemDiag/SystemDiag.c **** 	if((id < eERR_ID_FINISH) && (1 == gErrFilTab[id].enable))
 289:./Application/Funtion/SystemDiag/SystemDiag.c **** 	{
 290:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    /*检测是否可以设置恢复为A*/
 291:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    if((255 != gErrFilPara[id].maxTimes)                /*非无限次恢复*/
 292:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        && (eErr_B == gErrFilTab[id].filState)          /*正处于B状态*/
 293:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        && (eErr_A == state))                           /*需要设置为A状态*/
 294:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    {
 295:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        if(gErrFilTab[id].resTimes >= gErrFilPara[id].maxTimes)/*达到最大恢复次数*/
 296:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        {
 297:./Application/Funtion/SystemDiag/SystemDiag.c **** 	            return;                                     /*不能设置恢复为A*/
 298:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        }
 299:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    }
 300:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 301:./Application/Funtion/SystemDiag/SystemDiag.c **** 		gErrFilTab[id].nowState = state;
 302:./Application/Funtion/SystemDiag/SystemDiag.c **** 	}
 303:./Application/Funtion/SystemDiag/SystemDiag.c **** }
 304:./Application/Funtion/SystemDiag/SystemDiag.c **** 
