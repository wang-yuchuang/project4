 180:./Application/Funtion/SystemDiag/SystemDiag.c **** /*=================================================================================================
 181:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Name      : void DiagErrFilterTask(u8 from, u8 to)
 182:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Input     : from-to:检测故障滤波起始和结束ID(包括from不包to)
 183:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Output    : void
 184:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Function  : 故障诊断滤波任务
 185:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @The notes : 50ms周期调用,与DIAG_FILTER_TICK一致
 186:./Application/Funtion/SystemDiag/SystemDiag.c **** **===============================================================================================*/
 187:./Application/Funtion/SystemDiag/SystemDiag.c **** void DiagErrFilterTask(e_ERR_ID from, e_ERR_ID to)
 188:./Application/Funtion/SystemDiag/SystemDiag.c **** {
 189:./Application/Funtion/SystemDiag/SystemDiag.c **** 	e_ERR_ID i = eERR_ID_FINISH;
 190:./Application/Funtion/SystemDiag/SystemDiag.c **** 	e_ERR_ID temp = eERR_ID_FINISH;
 191:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 192:./Application/Funtion/SystemDiag/SystemDiag.c ****     if(to > temp)                                          /*to必须小于最大值*/
 193:./Application/Funtion/SystemDiag/SystemDiag.c ****     {
 194:./Application/Funtion/SystemDiag/SystemDiag.c ****         to = temp;
 195:./Application/Funtion/SystemDiag/SystemDiag.c ****     }
 196:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 197:./Application/Funtion/SystemDiag/SystemDiag.c ****     if(from > temp)                                        /*from必须小于最大值*/
 198:./Application/Funtion/SystemDiag/SystemDiag.c ****     {
 199:./Application/Funtion/SystemDiag/SystemDiag.c ****         from = temp;
 200:./Application/Funtion/SystemDiag/SystemDiag.c ****     }
 201:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 202:./Application/Funtion/SystemDiag/SystemDiag.c ****     if(from > to)                                           /*from 必须小于等于to*/
 203:./Application/Funtion/SystemDiag/SystemDiag.c ****     {
 204:./Application/Funtion/SystemDiag/SystemDiag.c ****         temp = from;
 205:./Application/Funtion/SystemDiag/SystemDiag.c ****         from = to;
ARM GAS  /tmp/ccW036vO.s 			page 5


 206:./Application/Funtion/SystemDiag/SystemDiag.c ****         to = temp;
 207:./Application/Funtion/SystemDiag/SystemDiag.c ****     }
 208:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 209:./Application/Funtion/SystemDiag/SystemDiag.c ****     for(i = from; i < to; i++)                              /*逐个检测指定故障id*/
 210:./Application/Funtion/SystemDiag/SystemDiag.c ****     {
 211:./Application/Funtion/SystemDiag/SystemDiag.c ****         if(IsEqual(gErrFilTab[i].enable, 1))                /*该故障id使能检测*/
 212:./Application/Funtion/SystemDiag/SystemDiag.c ****         {
 213:./Application/Funtion/SystemDiag/SystemDiag.c ****         	/*当前稳定状态*/
 214:./Application/Funtion/SystemDiag/SystemDiag.c ****             switch(gErrFilTab[i].filState)
 215:./Application/Funtion/SystemDiag/SystemDiag.c ****             {
 216:./Application/Funtion/SystemDiag/SystemDiag.c ****                 case eErr_A:                                /*正常状态*/
 217:./Application/Funtion/SystemDiag/SystemDiag.c ****                     if(IsEqual(gErrFilTab[i].nowState, eErr_B))/*如果其瞬态值是eErr_B则设�
 218:./Application/Funtion/SystemDiag/SystemDiag.c ****                     {
 219:./Application/Funtion/SystemDiag/SystemDiag.c ****                     	gErrFilTab[i].filState = eErr_AtoB;
 220:./Application/Funtion/SystemDiag/SystemDiag.c ****                     	gErrFilTab[i].timer = 0;
 221:./Application/Funtion/SystemDiag/SystemDiag.c ****                     }
 222:./Application/Funtion/SystemDiag/SystemDiag.c ****                     break;
 223:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 224:./Application/Funtion/SystemDiag/SystemDiag.c ****                 case eErr_AtoB:                             /*正常到故障的过渡态*/
