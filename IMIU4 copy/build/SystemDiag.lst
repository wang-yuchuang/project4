 166:./Application/Funtion/SystemDiag/SystemDiag.c **** **===============================================================================================*/
 167:./Application/Funtion/SystemDiag/SystemDiag.c **** e_ErrSort DiagGetFilErrSortAPI(e_ERR_ID id)
 168:./Application/Funtion/SystemDiag/SystemDiag.c **** {
 169:./Application/Funtion/SystemDiag/SystemDiag.c **** 	if(id < eERR_ID_FINISH)
 170:./Application/Funtion/SystemDiag/SystemDiag.c **** 	{
 171:./Application/Funtion/SystemDiag/SystemDiag.c ****         /*返回故障类型*/
 172:./Application/Funtion/SystemDiag/SystemDiag.c ****         return(gErrFilPara[id].errSort);
 173:./Application/Funtion/SystemDiag/SystemDiag.c **** 	}
 174:./Application/Funtion/SystemDiag/SystemDiag.c **** 	else
 175:./Application/Funtion/SystemDiag/SystemDiag.c **** 	{
 176:./Application/Funtion/SystemDiag/SystemDiag.c **** 		return(eErr_Norm);
 177:./Application/Funtion/SystemDiag/SystemDiag.c **** 	}
 178:./Application/Funtion/SystemDiag/SystemDiag.c **** }
