 312:./Application/Funtion/SystemDiag/SystemDiag.c **** void DiagSetErrFilStateAPI(e_ERR_ID id, e_ErrState state)
 313:./Application/Funtion/SystemDiag/SystemDiag.c **** {
 314:./Application/Funtion/SystemDiag/SystemDiag.c **** 	if((id < eERR_ID_FINISH) && (1 == gErrFilTab[id].enable)
 315:./Application/Funtion/SystemDiag/SystemDiag.c **** 		&& ((eErr_A == state) || (eErr_B == state)))
 316:./Application/Funtion/SystemDiag/SystemDiag.c **** 	{
 317:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    /*检测是否可以设置恢复为A*/
 318:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    if((255 != gErrFilPara[id].maxTimes)                /*非无限次恢复*/
 319:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        && (eErr_B == gErrFilTab[id].filState)          /*正处于B状态*/
ARM GAS  /tmp/ccW036vO.s 			page 7


 320:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        && (eErr_A == state))                           /*需要设置为A状态*/
 321:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    {
 322:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        if(gErrFilTab[id].resTimes >= gErrFilPara[id].maxTimes)/*达到最大恢复次数*/
 323:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        {
 324:./Application/Funtion/SystemDiag/SystemDiag.c **** 	            return;                                     /*不能设置恢复为A*/
 325:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        }
 326:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    }
 327:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 328:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    /*计算A->B的次数*/
 329:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    if((eErr_A == DiagGetErrLastStateAPI(id))           /*正处于A状态*/
 330:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        && (eErr_B == state))                           /*需要设置为B状态*/
 331:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    {
 332:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        if(gErrFilTab[id].resTimes < 254)               /*防止越界*/
 333:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        {
 334:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        	gErrFilTab[id].resTimes++;                  /*次数加1*/
 335:./Application/Funtion/SystemDiag/SystemDiag.c **** 	        }
 336:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    }
 337:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 338:./Application/Funtion/SystemDiag/SystemDiag.c **** 		gErrFilTab[id].nowState = state;
 339:./Application/Funtion/SystemDiag/SystemDiag.c **** 		gErrFilTab[id].filState = state;
 340:./Application/Funtion/SystemDiag/SystemDiag.c **** 	}
 341:./Application/Funtion/SystemDiag/SystemDiag.c **** }
