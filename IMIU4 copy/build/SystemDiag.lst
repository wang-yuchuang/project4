 348:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @The notes : 100ms周期,将滤波故障转入故障显示位
 349:./Application/Funtion/SystemDiag/SystemDiag.c **** **===============================================================================================*/
 350:./Application/Funtion/SystemDiag/SystemDiag.c **** void DiagErrDisplayTask(void)
 351:./Application/Funtion/SystemDiag/SystemDiag.c **** {
 352:./Application/Funtion/SystemDiag/SystemDiag.c **** 	// u16 flag = 0;
 353:./Application/Funtion/SystemDiag/SystemDiag.c **** 	e_ERR_ID i = eERR_ID_FINISH;
 354:./Application/Funtion/SystemDiag/SystemDiag.c **** 	// e_ERR_ID index = eERR_ID_FINISH;
 355:./Application/Funtion/SystemDiag/SystemDiag.c **** 	// static u8 sFlag = 0;
 356:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 357:./Application/Funtion/SystemDiag/SystemDiag.c ****     for(i = (e_ERR_ID)0; i < eERR_ID_FINISH; i++)           /*检测滤波最大个数*/
 358:./Application/Funtion/SystemDiag/SystemDiag.c ****     {
 359:./Application/Funtion/SystemDiag/SystemDiag.c **** 		if(eErr_B == DiagGetErrLastStateAPI(i))             /*出现告警*/
 360:./Application/Funtion/SystemDiag/SystemDiag.c **** 		{
 361:./Application/Funtion/SystemDiag/SystemDiag.c **** 			DiagSetErrState(i, 1);                   /*设置产生异常状态*/
 362:./Application/Funtion/SystemDiag/SystemDiag.c **** 		}
 363:./Application/Funtion/SystemDiag/SystemDiag.c **** 		else                                                /*无异常*/
 364:./Application/Funtion/SystemDiag/SystemDiag.c **** 		{
 365:./Application/Funtion/SystemDiag/SystemDiag.c **** 			DiagSetErrState(i, 0);                   /*清除异常状态*/
 366:./Application/Funtion/SystemDiag/SystemDiag.c **** 		}
 367:./Application/Funtion/SystemDiag/SystemDiag.c ****     }
 368:./Application/Funtion/SystemDiag/SystemDiag.c **** }
