 344:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Name      : void DiagErrDisplayTask(void)
 345:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Input     : void
 346:./Application/Funtion/SystemDiag/SystemDiag.c **** ** @Output    : void
