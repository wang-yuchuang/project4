 377:./Application/Funtion/SystemDiag/SystemDiag.c **** e_ErrState DiagGetErrLastStateAPI(e_ERR_ID id)
 378:./Application/Funtion/SystemDiag/SystemDiag.c **** {
 379:./Application/Funtion/SystemDiag/SystemDiag.c **** 	if(id < eERR_ID_FINISH)
 380:./Application/Funtion/SystemDiag/SystemDiag.c **** 	{
 381:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    /*如果a to b 则返回a*/
 382:./Application/Funtion/SystemDiag/SystemDiag.c **** 		if(IsEqual(gErrFilTab[id].filState, eErr_AtoB))
 383:./Application/Funtion/SystemDiag/SystemDiag.c **** 		{
 384:./Application/Funtion/SystemDiag/SystemDiag.c **** 		    return(eErr_A);
 385:./Application/Funtion/SystemDiag/SystemDiag.c **** 		}
 386:./Application/Funtion/SystemDiag/SystemDiag.c **** 	    /*如果b to a 则返回b*/
 387:./Application/Funtion/SystemDiag/SystemDiag.c **** 		else if(IsEqual(gErrFilTab[id].filState, eErr_BtoA))
 388:./Application/Funtion/SystemDiag/SystemDiag.c **** 		{
 389:./Application/Funtion/SystemDiag/SystemDiag.c **** 		    return(eErr_B);
 390:./Application/Funtion/SystemDiag/SystemDiag.c **** 		}
 391:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 392:./Application/Funtion/SystemDiag/SystemDiag.c **** 		return(gErrFilTab[id].filState);
 393:./Application/Funtion/SystemDiag/SystemDiag.c **** 	}
 394:./Application/Funtion/SystemDiag/SystemDiag.c **** 
 395:./Application/Funtion/SystemDiag/SystemDiag.c **** 	return(eErr_A);
 396:./Application/Funtion/SystemDiag/SystemDiag.c **** }
