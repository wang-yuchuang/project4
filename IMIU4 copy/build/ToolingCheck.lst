 126:./Application/Funtion/Usart/ToolingCheck.c ****     // 1. 如果已经成功（0x5A）直接返回,寄存器中有 有效数据; 失败（0xFF）�
 127:./Application/Funtion/Usart/ToolingCheck.c ****     if (version_flag == 0x5A)
 128:./Application/Funtion/Usart/ToolingCheck.c ****     {
 129:./Application/Funtion/Usart/ToolingCheck.c ****         return;
 130:./Application/Funtion/Usart/ToolingCheck.c ****     }
 131:./Application/Funtion/Usart/ToolingCheck.c ****     else if(version_flag == 0xFF)
 132:./Application/Funtion/Usart/ToolingCheck.c ****     {
