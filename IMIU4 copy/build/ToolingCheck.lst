 134:./Application/Funtion/Usart/ToolingCheck.c ****         ModbusReg[REG_HARDWARE_V][0] = 0;
 135:./Application/Funtion/Usart/ToolingCheck.c ****         ModbusReg[REG_BOOT_V][1] = 0;
 136:./Application/Funtion/Usart/ToolingCheck.c ****         ModbusReg[REG_BOOT_V][0] = 0;
