 142:./Application/Funtion/Usart/ToolingCheck.c ****     else if (version_flag == 0)
 143:./Application/Funtion/Usart/ToolingCheck.c ****     {
 144:./Application/Funtion/Usart/ToolingCheck.c ****         u8 read_success = 0;
 145:./Application/Funtion/Usart/ToolingCheck.c ****         u8 valueEEP = 0;
 146:./Application/Funtion/Usart/ToolingCheck.c ****         u8 valueFlash = 0;
 147:./Application/Funtion/Usart/ToolingCheck.c ****     
ARM GAS  /tmp/ccjXlnl7.s 			page 4


 148:./Application/Funtion/Usart/ToolingCheck.c ****         // 1. 先尝试从EEPROM读取
 149:./Application/Funtion/Usart/ToolingCheck.c ****     
 150:./Application/Funtion/Usart/ToolingCheck.c ****         // 读取完整数据到stParameter
 151:./Application/Funtion/Usart/ToolingCheck.c ****         valueEEP = I2C_EE_BufferRead((u8*)&stParameter, Eeprom_ParaAddress_Start, sizeof(stParamete
 152:./Application/Funtion/Usart/ToolingCheck.c ****         if (valueEEP == TRUE)
 153:./Application/Funtion/Usart/ToolingCheck.c ****         {
 154:./Application/Funtion/Usart/ToolingCheck.c ****             read_success = 1;
 155:./Application/Funtion/Usart/ToolingCheck.c ****         }
 156:./Application/Funtion/Usart/ToolingCheck.c ****         // 2. 如果EEPROM没有有效数据，再尝试Flash
 157:./Application/Funtion/Usart/ToolingCheck.c ****         else
 158:./Application/Funtion/Usart/ToolingCheck.c ****         {
 159:./Application/Funtion/Usart/ToolingCheck.c ****                 // 读取完整数据到stParameter
