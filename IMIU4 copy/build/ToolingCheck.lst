 161:./Application/Funtion/Usart/ToolingCheck.c ****                 if (valueFlash == GD25Qx_OK)
 162:./Application/Funtion/Usart/ToolingCheck.c ****                 {
 163:./Application/Funtion/Usart/ToolingCheck.c ****                     read_success = 1;
 164:./Application/Funtion/Usart/ToolingCheck.c ****                 }
 165:./Application/Funtion/Usart/ToolingCheck.c ****         }
 166:./Application/Funtion/Usart/ToolingCheck.c ****         
 167:./Application/Funtion/Usart/ToolingCheck.c ****         // 3. 如果任一存储设备读取成功，更新寄存器
 168:./Application/Funtion/Usart/ToolingCheck.c ****         if (read_success == 1)
 169:./Application/Funtion/Usart/ToolingCheck.c ****         {
 170:./Application/Funtion/Usart/ToolingCheck.c ****             // 更新Modbus寄存器
 171:./Application/Funtion/Usart/ToolingCheck.c ****             ModbusReg[REG_HARDWARE_V][0] = (stParameter.u16HardwareVersion >> 8) & 0xFF;
 172:./Application/Funtion/Usart/ToolingCheck.c ****             ModbusReg[REG_HARDWARE_V][1] = stParameter.u16HardwareVersion & 0xFF;
 173:./Application/Funtion/Usart/ToolingCheck.c ****             ModbusReg[REG_BOOT_V][0]     = (stParameter.u16BootVersion >> 8) & 0xFF;
