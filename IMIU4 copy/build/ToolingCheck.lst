 195:./Application/Funtion/Usart/ToolingCheck.c ****         stParameter.u16AppVersion = (ModbusReg[REG_APP_V][0] << 8) | ModbusReg[REG_APP_V][1];
 196:./Application/Funtion/Usart/ToolingCheck.c **** 
 197:./Application/Funtion/Usart/ToolingCheck.c ****         if (TRUE == I2C_EE_BufferWrite((u8*)&stParameter,Eeprom_ParaAddress_Start,sizeof(stParamete
 198:./Application/Funtion/Usart/ToolingCheck.c ****         {
