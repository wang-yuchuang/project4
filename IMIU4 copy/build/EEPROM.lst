  36:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c **** ** @Function  : 将缓冲区中的数据写到I2C EEPROM中
  37:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c **** ** @The notes :该函数会自动判断是否超页，如超页自动换页
  38:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c **** **===========================================================================================*/
  39:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c **** u8 I2C_EE_BufferWrite(u8* pBuffer, u16 WriteAddr, u16 NumByteToWrite)
  40:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c **** {
  41:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****   u8 NumOfPage = 0, NumOfSingle = 0, Addr = 0, count = 0;
  42:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****   Addr = WriteAddr % EEPROM_PAGESIZE;
  43:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****   count = EEPROM_PAGESIZE - Addr;
  44:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****   NumOfPage =  NumByteToWrite / EEPROM_PAGESIZE;
  45:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****   NumOfSingle = NumByteToWrite % EEPROM_PAGESIZE;
  46:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****   /* If WriteAddr is I2C_PageSize aligned  */
  47:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****   if(Addr == 0) 
  48:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****   {
  49:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     /* If NumByteToWrite < I2C_PageSize */
  50:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     if(NumOfPage == 0) 
  51:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     {
  52:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****       if(TRUE != I2C_EE_PageWrite(pBuffer, WriteAddr, NumOfSingle))
  53:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****       {
  54:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****         return FALSE;
  55:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****       }
  56:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     }
  57:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     /* If NumByteToWrite > I2C_PageSize */
  58:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     else  
  59:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     {
  60:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****       while(NumOfPage--)
  61:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****       {
  62:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****         if(TRUE != I2C_EE_PageWrite(pBuffer, WriteAddr, EEPROM_PAGESIZE))
  63:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****         {
  64:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****           return FALSE;
  65:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****         }
  66:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****         WriteAddr +=  EEPROM_PAGESIZE;
  67:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****         pBuffer += EEPROM_PAGESIZE;
  68:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****       }
  69:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c **** 
  70:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****       if(NumOfSingle!=0)
  71:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****       {
  72:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****         if(TRUE != I2C_EE_PageWrite(pBuffer, WriteAddr, NumOfSingle))
  73:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****         {
  74:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****           return FALSE;
  75:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****         }
  76:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****       }
  77:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     }
  78:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****   }
  79:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****   /* If WriteAddr is not I2C_PageSize aligned  */
  80:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****   else 
  81:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****   {
  82:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     /* If NumByteToWrite < I2C_PageSize */
  83:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     if(NumOfPage== 0) 
  84:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     {
  85:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****         if(TRUE != I2C_EE_PageWrite(pBuffer, WriteAddr, NumOfSingle))
  86:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****         {
  87:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****           return FALSE;
  88:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****         }
  89:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     }
  90:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     /* If NumByteToWrite > I2C_PageSize */
  91:./Application/BSPSys/BSPDevice/eeprom/EEPROM.c ****     else
