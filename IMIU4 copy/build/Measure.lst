1011:./Application/Funtion/Measure/Measure.c ****         {
1012:./Application/Funtion/Measure/Measure.c ****             current = (volt - ZeroVolt) * CurrRange / VoltRange / 10.0f;  /* 计算电流 A */ 
1013:./Application/Funtion/Measure/Measure.c **** 
1014:./Application/Funtion/Measure/Measure.c ****             if ((FABS(current) >= HALL_C_SAMP_RANGDEL)&& (FABS(current) <= CurrRange_A))
1015:./Application/Funtion/Measure/Measure.c ****             {
1016:./Application/Funtion/Measure/Measure.c ****                 return current;
1017:./Application/Funtion/Measure/Measure.c ****             }
