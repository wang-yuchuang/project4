 992:./Application/Funtion/Measure/Measure.c **** ** @The notes : 判断HALL电压电流是否超量程，超量程电流清零
 993:./Application/Funtion/Measure/Measure.c **** **===========================================================================================*/
 994:./Application/Funtion/Measure/Measure.c **** static f32 CalcCalibHallCurrent(f32 volt, f32 ZeroVolt, f32 VoltRange, f32 CurrRange)
 995:./Application/Funtion/Measure/Measure.c **** {
 996:./Application/Funtion/Measure/Measure.c ****     f32 VoltOffest = 0;
ARM GAS  /tmp/ccC3qtmq.s 			page 19


 997:./Application/Funtion/Measure/Measure.c ****     f32 current = 0.0f;
