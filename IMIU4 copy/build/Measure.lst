1080:./Application/Funtion/Measure/Measure.c **** {
1081:./Application/Funtion/Measure/Measure.c ****     f32 ShuntCurrent = 0;
1082:./Application/Funtion/Measure/Measure.c **** 
1083:./Application/Funtion/Measure/Measure.c ****     if((FABS(ShuntVolt) > 1e-6f)
1084:./Application/Funtion/Measure/Measure.c ****         &&(FABS(VoltRange) > 1e-6f)
1085:./Application/Funtion/Measure/Measure.c ****         &&(FABS(CurrRange) > 1e-6f))
1086:./Application/Funtion/Measure/Measure.c ****     {
