 946:./Application/Funtion/Measure/Measure.c **** ** @Name      : static f32 CalibVoltCheck(f32 Volt, u32 KBFlag, f32 K, f32 B)
 947:./Application/Funtion/Measure/Measure.c **** ** @Input     : 电压值 校准标志 K B
 948:./Application/Funtion/Measure/Measure.c **** ** @Output    : 校准后电压
 949:./Application/Funtion/Measure/Measure.c **** ** @Function  : 计算校准电压
 950:./Application/Funtion/Measure/Measure.c **** ** @The notes : 判断是否满足校准条件 计算校准后电压
 951:./Application/Funtion/Measure/Measure.c **** **===========================================================================================*/
 952:./Application/Funtion/Measure/Measure.c **** static f32 CalibVoltCheck(f32 Volt, u32 KBFlag, f32 K, f32 B)
 953:./Application/Funtion/Measure/Measure.c **** {
 954:./Application/Funtion/Measure/Measure.c ****     if((1 == KBFlag) && (IsCoefValid(K, B) == TRUE))//判断kb值是否有效
 955:./Application/Funtion/Measure/Measure.c ****     {
 956:./Application/Funtion/Measure/Measure.c ****         Volt = (f32)(Volt*K + B);
 957:./Application/Funtion/Measure/Measure.c ****     }else
 958:./Application/Funtion/Measure/Measure.c ****     {
 959:./Application/Funtion/Measure/Measure.c ****         Volt = (f32)(Volt);
 960:./Application/Funtion/Measure/Measure.c ****     }
 961:./Application/Funtion/Measure/Measure.c ****     return Volt;
 962:./Application/Funtion/Measure/Measure.c **** }
