1000:./Application/Funtion/Measure/Measure.c ****     f32 VoltRange_mV = VoltRange * 100.0f;
1001:./Application/Funtion/Measure/Measure.c ****     f32 CurrRange_A = CurrRange * 10.0f;
1002:./Application/Funtion/Measure/Measure.c ****     
1003:./Application/Funtion/Measure/Measure.c ****     if ((FABS(volt) > 1e-6f) 
1004:./Application/Funtion/Measure/Measure.c ****      && (FABS(ZeroVolt) > 1e-6f)  
1005:./Application/Funtion/Measure/Measure.c ****      && (FABS(VoltRange) > 1e-6f) 
1006:./Application/Funtion/Measure/Measure.c ****      && (FABS(CurrRange) > 1e-6f))
1007:./Application/Funtion/Measure/Measure.c ****     {
1008:./Application/Funtion/Measure/Measure.c ****         VoltOffest = volt - ZeroVolt;//
1009:./Application/Funtion/Measure/Measure.c **** 
