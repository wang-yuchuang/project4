 964:./Application/Funtion/Measure/Measure.c **** /*=============================================================================================
 965:./Application/Funtion/Measure/Measure.c **** ** @Name      : static f32 CalcHallCurrent(f32 volt, f32 ZeroVolt, f32 VoltRange, f32 CurrRange)
 966:./Application/Funtion/Measure/Measure.c **** ** @Input     : void
 967:./Application/Funtion/Measure/Measure.c **** ** @Output    : 校准前HALL电流计算结果
 968:./Application/Funtion/Measure/Measure.c **** ** @Function  : 校准前Hall电流计算
 969:./Application/Funtion/Measure/Measure.c **** ** @The notes : 
 970:./Application/Funtion/Measure/Measure.c **** **===========================================================================================*/
 971:./Application/Funtion/Measure/Measure.c **** static f32 CalcHallCurrent(f32 volt, f32 ZeroVolt, f32 VoltRange, f32 CurrRange)
 972:./Application/Funtion/Measure/Measure.c **** {
 973:./Application/Funtion/Measure/Measure.c ****    
 974:./Application/Funtion/Measure/Measure.c ****     f32 current = 0.0f;
 975:./Application/Funtion/Measure/Measure.c **** 
 976:./Application/Funtion/Measure/Measure.c ****     if((FABS(volt) > 1e-6f)
 977:./Application/Funtion/Measure/Measure.c ****     &&(FABS(ZeroVolt) > 1e-6f)
 978:./Application/Funtion/Measure/Measure.c ****     &&(FABS(VoltRange) > 1e-6f)
 979:./Application/Funtion/Measure/Measure.c ****     &&(FABS(CurrRange) > 1e-6f))
 980:./Application/Funtion/Measure/Measure.c ****     {
 981:./Application/Funtion/Measure/Measure.c ****         current = (volt - ZeroVolt) * CurrRange / VoltRange / 10.0f;  /* 计算电流 A */ 
 982:./Application/Funtion/Measure/Measure.c ****         return current;
 983:./Application/Funtion/Measure/Measure.c ****     }
 984:./Application/Funtion/Measure/Measure.c ****     return 0;
 985:./Application/Funtion/Measure/Measure.c **** }
