 172:./Application/Funtion/Measure/Measure.c **** /*==========================================================================
 173:./Application/Funtion/Measure/Measure.c **** ** @Name      : void CalcFast3Results(void)
 174:./Application/Funtion/Measure/Measure.c **** ** @Function  : 仅计算快路径3个分流器电流 (从原Ka84917VoltCurrentCalculate和
 175:./Application/Funtion/Measure/Measure.c **** **              Rn8209VoltCurrentCalculate中拆分, 计算逻辑不变)
 176:./Application/Funtion/Measure/Measure.c **** **   计算结果: BatShuntCurrent1, BatShuntCurrent2, LinkShuntCurrent
 177:./Application/Funtion/Measure/Measure.c **** **========================================================================*/
 178:./Application/Funtion/Measure/Measure.c **** void CalcFast3Results(void)
 179:./Application/Funtion/Measure/Measure.c **** {
 180:./Application/Funtion/Measure/Measure.c ****     /* 通信异常时填充默认值 */
 181:./Application/Funtion/Measure/Measure.c ****     if ((wakeUpState == 0) || (ucSPI_GetComError() != SPI_NOERR))
 182:./Application/Funtion/Measure/Measure.c ****     {
 183:./Application/Funtion/Measure/Measure.c ****         InPutSystemDataArray(BatShuntCurrentL, 0);
 184:./Application/Funtion/Measure/Measure.c ****         InPutSystemDataArray(BatShuntCurrentH, 0);
 185:./Application/Funtion/Measure/Measure.c ****         InPutSystemDataArray(LinkShuntCurrentL, 0);
 186:./Application/Funtion/Measure/Measure.c ****         InPutSystemDataArray(LinkShuntCurrentH, 0);
 187:./Application/Funtion/Measure/Measure.c ****         BitSet16(SystemData_51[DidoGpioState], DaisyComFail);
 188:./Application/Funtion/Measure/Measure.c ****         return;
 189:./Application/Funtion/Measure/Measure.c ****     }
 190:./Application/Funtion/Measure/Measure.c ****     if (FirstSampleFinishedFlag == 0)
 191:./Application/Funtion/Measure/Measure.c ****     {
 192:./Application/Funtion/Measure/Measure.c ****         InPutSystemDataArray(BatShuntCurrentL, 0);
 193:./Application/Funtion/Measure/Measure.c ****         InPutSystemDataArray(BatShuntCurrentH, 0);
 194:./Application/Funtion/Measure/Measure.c ****         InPutSystemDataArray(LinkShuntCurrentL, 0);
 195:./Application/Funtion/Measure/Measure.c ****         InPutSystemDataArray(LinkShuntCurrentH, 0);
 196:./Application/Funtion/Measure/Measure.c ****         return;
 197:./Application/Funtion/Measure/Measure.c ****     }
 198:./Application/Funtion/Measure/Measure.c ****     BitClr16(SystemData_51[DidoGpioState], DaisyComFail);
ARM GAS  /tmp/ccC3qtmq.s 			page 5


 199:./Application/Funtion/Measure/Measure.c **** 
 200:./Application/Funtion/Measure/Measure.c ****     
 201:./Application/Funtion/Measure/Measure.c ****     /* 变量声明 */
 202:./Application/Funtion/Measure/Measure.c ****     f32 fShuntVolt1 = 0, fShuntCurrent1 = 0;
 203:./Application/Funtion/Measure/Measure.c ****     f32 fShuntVolt2 = 0, fShuntCurrent2 = 0;
 204:./Application/Funtion/Measure/Measure.c ****     u32 u32ShuntCurrentAdSum1 = 0, u32ShuntCurrentAd1 = 0;
 205:./Application/Funtion/Measure/Measure.c ****     u32 u32ShuntCurrentAdSum2 = 0, u32ShuntCurrentAd2 = 0;
 206:./Application/Funtion/Measure/Measure.c ****     u8 u8ShuntCurrentCount1 = 0, u8ShuntCurrentCount2 = 0;
 207:./Application/Funtion/Measure/Measure.c ****     s32 s32fShuntCurrent1 = 0, s32fShuntCurrent2 = 0, s32HallCurrent = 0;
 208:./Application/Funtion/Measure/Measure.c **** 
 209:./Application/Funtion/Measure/Measure.c ****     f32 fShuntVoltRange, fShuntCurrRange;
 210:./Application/Funtion/Measure/Measure.c ****     fShuntVoltRange = stParameter.u16ArraySet[ShuntVoltSampRange];
 211:./Application/Funtion/Measure/Measure.c ****     fShuntCurrRange = stParameter.u16ArraySet[ShuntCurrentSampRange]*10;
 212:./Application/Funtion/Measure/Measure.c **** 
 213:./Application/Funtion/Measure/Measure.c ****     /*=== 1. 电池端分流器电流1 (from FIFO[0] C7) ===*/
 214:./Application/Funtion/Measure/Measure.c ****     for(int i = 0; i < 16; i++)
 215:./Application/Funtion/Measure/Measure.c ****     {
 216:./Application/Funtion/Measure/Measure.c ****         if(usSPI_RegFifo_Data[0][i] != 0)
 217:./Application/Funtion/Measure/Measure.c ****         {
 218:./Application/Funtion/Measure/Measure.c ****             u32ShuntCurrentAdSum1 += (usSPI_RegFifo_Data[0][i]>>16);
 219:./Application/Funtion/Measure/Measure.c ****             u8ShuntCurrentCount1++;
 220:./Application/Funtion/Measure/Measure.c ****         }
 221:./Application/Funtion/Measure/Measure.c ****     }
 222:./Application/Funtion/Measure/Measure.c ****     u32ShuntCurrentAd1 = (u8ShuntCurrentCount1 != 0)
 223:./Application/Funtion/Measure/Measure.c ****         ? (u32ShuntCurrentAdSum1/u8ShuntCurrentCount1) : 0x8000;
 224:./Application/Funtion/Measure/Measure.c **** 
 225:./Application/Funtion/Measure/Measure.c ****     if(0X8000 == (u32ShuntCurrentAd1 & 0x8000))//为正压
 226:./Application/Funtion/Measure/Measure.c ****     {
 227:./Application/Funtion/Measure/Measure.c ****         fShuntVolt1 = u32ShuntCurrentAd1 & 0x7fff;
 228:./Application/Funtion/Measure/Measure.c ****         fShuntVolt1 = fShuntVolt1*0.000007629f*1000.0f;
 229:./Application/Funtion/Measure/Measure.c ****     }
 230:./Application/Funtion/Measure/Measure.c ****     else//为负压
 231:./Application/Funtion/Measure/Measure.c ****     {
 232:./Application/Funtion/Measure/Measure.c ****         fShuntVolt1 = u32ShuntCurrentAd1 & 0x7fff;
 233:./Application/Funtion/Measure/Measure.c ****         fShuntVolt1 = (fShuntVolt1*0.000007629f-0.25f)*1000.0f;
 234:./Application/Funtion/Measure/Measure.c ****     }
 235:./Application/Funtion/Measure/Measure.c ****     InPutBatShuntVolt(fShuntVolt1);//单位mv
 236:./Application/Funtion/Measure/Measure.c **** 
 237:./Application/Funtion/Measure/Measure.c ****     fShuntCurrent1 = CalcShuntCurrent(fShuntVolt1, fShuntVoltRange, fShuntCurrRange);
