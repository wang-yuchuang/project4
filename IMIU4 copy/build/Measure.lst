 987:./Application/Funtion/Measure/Measure.c **** /*=============================================================================================
 988:./Application/Funtion/Measure/Measure.c **** ** @Name      : static f32 CalcCalibHallCurrent(f32 volt, f32 ZeroVolt, f32 VoltRange, f32 CurrRang
 989:./Application/Funtion/Measure/Measure.c **** ** @Input     : void
